+#ifndef DISABLE_THREADS
+	(void)type;
+	(void)index;
+	return 0;
+#else
+	if (!jiterp_table_reclamation_enabled ())
+		return 0;
+	if ((type < 0) || (type > JITERPRETER_TABLE_LAST))
+		return 0;
