+	// function table — the self-test only exercises allocator bookkeeping.
+	table->first_index = 2;
+	table->last_index = 4;
+	table->next_index = 2;
+	table_free_slots [type] = NULL;
+	table_free_counts [type] = 0;
+	table_total_freed [type] = 0;
+	table_total_reused [type] = 0;
