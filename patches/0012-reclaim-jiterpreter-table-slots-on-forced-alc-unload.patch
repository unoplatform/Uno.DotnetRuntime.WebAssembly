+            foreach (WeakReference weakRef in refs)
+            {
+                Assert.False(weakRef.IsAlive,
+                    "A forced-down collectible AssemblyLoadContext should stay reclaimable after jiterpreter slot reclamation.");
+            }
+        }
+    }
