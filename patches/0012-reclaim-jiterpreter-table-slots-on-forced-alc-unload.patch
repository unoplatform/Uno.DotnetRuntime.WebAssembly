+                $"(fresh {freshDelta} + reused {reusedDelta} - freed {freedDelta}) = {netConsumption} over " +
+                $"{MeasuredCycles} cycles (>= {MeasuredCycles} means at least one slot leaks every cycle; " +
+                $"free={TraceStat(StatFreeCount)}).");
