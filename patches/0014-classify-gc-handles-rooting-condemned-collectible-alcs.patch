+/*
+ * The kinds 11-23 reader. Defined HERE, inside the DISABLE_THREADS region, so the gate sits
+ * with the code it guards instead of being inherited from an enclosing block hundreds of lines
+ * away; the icall's switch does nothing but forward to it.
+ */
+static int
+alc_condemned_diag_read (int kind)
+{
+	AlcCondemnedSnapshot *snap = &alc_condemned_snapshot;
+
+	/* The three kinds that must be answered WITHOUT the "take one if none exists" fallback
+	 * below: two of them take one themselves, and the third must never take one at all. */
+	switch (kind) {
+	case 17:
+		alc_condemned_snapshot_take (ALC_CONDEMNED_HANDLE_SLOT_BUDGET);
+		return snap->sequence;
+	case 23:
+		/* Same snapshot under the self-test raw-slot cap; see the constant's comment. */
+		alc_condemned_snapshot_take (ALC_CONDEMNED_HANDLE_SELFTEST_SLOT_BUDGET);
+		return snap->sequence;
+	case 20:
+		/* THE TOKEN (see the ATOMICITY note). Reports the latched generation and recomputes
+		 * NOTHING — that is the whole contract, because a reader uses it to decide whether the
+		 * gauges it just read all came from one generation. Refreshing here would destroy the
+		 * only thing a reader can use to detect a mixed tuple, so this case deliberately sits
+		 * ahead of the fallback: 0 ("no snapshot has ever been taken") is a truthful answer. */
+		return snap->sequence;
+	default:
+		break;
+	}
+
+	/* A lone read still answers, but reading several kinds without a preceding kind 17 serves
+	 * one older snapshot to all of them BY DESIGN — consistency beats freshness here (see the
+	 * ATOMICITY note). Callers that want fresh values take kind 17 first, then validate with
+	 * kind 20. */
+	if (snap->sequence == 0)
+		alc_condemned_snapshot_take (ALC_CONDEMNED_HANDLE_SLOT_BUDGET);
+
+	switch (kind) {
+	case 11:
+	case 12:
+	case 13:
+	case 14:
+		return snap->handles_available ? snap->handle_counts [kind - 11] : -1;
+	case 15:
+		return snap->managers_in_scope;
+	case 16:
+		return snap->live_witnesses;
+	case 18:
+		return snap->handles_available ? (snap->saturated ? 1 : 0) : -1;
+	case 19:
+		return snap->handles_available ? snap->identity_hits : -1;
+	case 21:
+		return snap->handles_available ? snap->slots_visited : -1;
+	case 22:
+		return snap->handles_available ? snap->slots_eligible : -1;
+	default:
+		return -1;
+	}
+}
