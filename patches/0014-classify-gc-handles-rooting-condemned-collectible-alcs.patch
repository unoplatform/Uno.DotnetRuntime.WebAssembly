+#ifdef DISABLE_THREADS
+/*
+ * GC-handle classification for the host-triggered collectible AssemblyLoadContext unload
+ * diagnostics. The canonical rationale, the exact attribution CONTRACT and its documented
+ * blind spots live with the consumer, in the "Root classification for condemned collectible
+ * contexts" block of assembly-load-context.c; this file only implements the sgen walk.
+ *
+ * In one line: for every live GC handle, report whether its TARGET object is attributable to
+ * the condemned set, either because the target's class belongs to one of the condemned memory
+ * managers (bucketed by handle type) or because the target IS one of the condemned contexts'
+ * own runtime objects (identity). Attribution is per-handle and NON-transitive: a handle on a
+ * container that merely REFERENCES a condemned instance is not attributed. See the consumer's
+ * contract block for the enumerated miss classes.
+ *
+ * Read-only in the strict sense: the walk goes through sgen_gchandle_foreach_slot_bounded,
+ * whose callback returns nothing and whose slots are never written back — no self-store, no
+ * dislink protocol update, nothing for the collector to observe.
+ *
+ * BOUNDED, which sgen_gchandle_iterate is NOT. That iterator walks each table to its
+ * persistent `next_slot` high-water mark — a mark sgen_gchandle_free never lowers, since
+ * freeing only NULLs a slot — and its callback cannot stop it. A table that once grew large and
+ * is now mostly holes would therefore be swept end to end on every read, once per type pass,
+ * regardless of how few handles are actually classified. Since this runs synchronously on the
+ * single browser thread at a host's request, that is a pause hazard, not merely wasted work.
+ * sgen_gchandle_foreach_slot_bounded instead clamps the RAW slot range and reports the mark it
+ * was eligible to cover, and the loop below spends ONE budget across all four passes: total
+ * work is scan->slot_budget raw slots, whatever the tables' history. Truncation is reported as
+ * scan->saturated so the counts are read as lower bounds rather than as facts.
+ *
+ * PRECONDITION, asserted rather than argued in prose. The handle tables must not be mutated
+ * underneath the walk. A multi-threaded runtime would get that from a collection pause (which
+ * is why sgen_gchandle_iterate is annotated MONO_PERMIT (need (sgen_world_stopped))); this
+ * entry point is compiled only for the single-threaded browser runtime (DISABLE_THREADS), so
+ * "no other mutator can touch the tables" holds by construction — and because the walk writes
+ * nothing, it needs no permit of its own. What remains to be guaranteed is that the COLLECTOR
+ * is not midway through rewriting slots underneath us, and that the walk is not re-entered.
+ * Both are asserted below instead of assumed.
+ *
+ * Dereferencing a target's vtable is safe for the same reason the forced teardown is: a
+ * memory manager is only freed once its whole witness set is dead, so no live object can
+ * outlive its own class's memory manager. m_class_get_mem_manager is a pure lookup — a
+ * generic-instance owner pointer, an array's element-class recursion, or the class's image ALC
+ * (falling back to the default ALC's manager for dynamic assemblies) — so it cannot lazily
+ * allocate a manager mid-walk, which is what makes "read-only" true of the whole operation
+ * and not merely of the handle slots.
+ */
+
+/* Re-entrancy guard for the assert below (single-threaded build: no atomics needed). */
+static gboolean sgen_condemned_scan_in_progress;
+
+typedef struct {
+	MonoSgenCondemnedHandleScan *scan;
+	int bucket;
+} SgenCondemnedScanCtx;
+
+static void
+sgen_condemned_handle_visit (gpointer hidden, GCHandleType handle_type, gpointer user)
+{
+	SgenCondemnedScanCtx *ctx = (SgenCondemnedScanCtx *)user;
+	MonoSgenCondemnedHandleScan *scan = ctx->scan;
+
+	/* No liveness filtering and no generation filtering: every live handle counts. Skip empty
+	 * slots and slots holding a metadata (non-object) pointer — those are still counted as
+	 * VISITED by the bounded walk, because the budget bounds the sweep, not the hits. */
+	if (!MONO_GC_HANDLE_VALID (hidden) || !MONO_GC_HANDLE_IS_OBJECT_POINTER (hidden))
+		return;
+
+	GCObject *obj = (GCObject *)MONO_GC_REVEAL_POINTER (hidden, GC_HANDLE_TYPE_IS_WEAK (handle_type));
+	if (!obj)
+		return;
+
+	/*
+	 * Identity attribution, checked FIRST and class-blind: the condemned contexts' own
+	 * runtime objects (the managed AssemblyLoadContext wrapper and each manager's
+	 * LoaderAllocator witness) are corelib-classed, so class attribution cannot see them —
+	 * yet a strong handle on one is exactly what pins a teardown (the runtime itself installs
+	 * such a handle when a managed Unload is requested). Counted separately so the caller can
+	 * tell the runtime's own expected roots from third-party ones.
+	 */
+	if (scan->condemned_objects && g_hash_table_contains (scan->condemned_objects, obj)) {
+		/* PER HANDLE, not per object: two handles onto the same wrapper count twice. */
+		scan->identity_hits++;
+		return;
+	}
+
+	if (!scan->condemned_managers)
+		return;
+
+	MonoVTable *vtable = (MonoVTable *)SGEN_LOAD_VTABLE (obj);
+	if (!vtable || !vtable->klass)
+		return;
+
+	MonoMemoryManager *mm = m_class_get_mem_manager (vtable->klass);
+	/* O(1) membership: a set keyed on the manager POINTER, so cost stays linear in handles
+	 * however many contexts are stranded (a per-handle scan over the manager list would
+	 * degrade quadratically in exactly the stranded state this diagnostic exists to explain). */
+	if (mm && g_hash_table_contains (scan->condemned_managers, mm))
+		scan->class_hits [ctx->bucket]++;
+}
+
+void
+sgen_scan_handles_into_managers (MonoSgenCondemnedHandleScan *scan)
+{
+	static const GCHandleType bucket_types [MONO_SGEN_CONDEMNED_HANDLE_BUCKETS] =
+		{ HANDLE_NORMAL, HANDLE_PINNED, HANDLE_WEAK, HANDLE_WEAK_TRACK };
+
+	/* Internal API, but a NULL out-parameter must never be written through. */
+	if (!scan)
+		return;
+
+	for (int i = 0; i < MONO_SGEN_CONDEMNED_HANDLE_BUCKETS; ++i)
+		scan->class_hits [i] = 0;
+	scan->identity_hits = 0;
+	scan->slots_visited = 0;
+	scan->slots_eligible = 0;
+	scan->saturated = FALSE;
+
+	/* Nothing to attribute to: skip the sweep entirely rather than walking every handle
+	 * table to accumulate zeroes. Nothing was ELIGIBLE either, because no walk ran. */
+	guint n_managers = scan->condemned_managers ? g_hash_table_size (scan->condemned_managers) : 0;
+	guint n_objects = scan->condemned_objects ? g_hash_table_size (scan->condemned_objects) : 0;
+	if (n_managers == 0 && n_objects == 0)
+		return;
+
+	/* See PRECONDITION above: not inside a collection pause (the collector is not rewriting
+	 * handle slots underneath the walk), and not re-entered. */
+	g_assert (sgen_get_current_collection_generation () == -1);
+	g_assert (!sgen_condemned_scan_in_progress);
+	sgen_condemned_scan_in_progress = TRUE;
+
+	/*
+	 * ONE raw-slot budget shared by all four type passes, so the bound is on the WHOLE
+	 * operation rather than on each pass: total work is `budget` slot loads even if every
+	 * table carries a huge historical high-water mark. A pass that gets a spent budget visits
+	 * nothing and contributes 0 to its bucket — hence `saturated`, which the consumer surfaces
+	 * so those zeroes are never mistaken for "no such handle exists".
+	 */
+	guint32 budget = scan->slot_budget > 0 ? (guint32)scan->slot_budget : G_MAXUINT32;
+
+	SgenCondemnedScanCtx ctx;
+	ctx.scan = scan;
+	for (int i = 0; i < MONO_SGEN_CONDEMNED_HANDLE_BUCKETS; ++i) {
+		guint32 high_water = 0;
+		guint32 remaining = budget - (guint32)scan->slots_visited;
+		ctx.bucket = i;
+		guint32 visited = sgen_gchandle_foreach_slot_bounded (bucket_types [i], remaining, &high_water,
+				sgen_condemned_handle_visit, &ctx);
+		scan->slots_visited += (gint32)visited;
+		scan->slots_eligible += (gint32)high_water;
+		if (visited < high_water)
+			scan->saturated = TRUE;
+	}
+
+	sgen_condemned_scan_in_progress = FALSE;
+}
+#endif /* DISABLE_THREADS */
+
