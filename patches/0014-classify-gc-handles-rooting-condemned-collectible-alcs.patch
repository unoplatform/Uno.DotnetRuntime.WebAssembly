index e7611b1b9..b6fd5b893 100644
--- a/src/mono/mono/metadata/sgen-mono.c
+++ b/src/mono/mono/metadata/sgen-mono.c
@@ -1901,6 +1901,147 @@ mono_gc_walk_heap (int flags, MonoGCReferences callback, void *data)
