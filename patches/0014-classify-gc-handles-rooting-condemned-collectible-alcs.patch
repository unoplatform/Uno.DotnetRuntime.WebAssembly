+        /// <summary>
+        /// Root-classification regression (stats kinds 11-16). A downstream WASM host whose
+        /// teardown reports NotQuiescent forever needs to know WHICH class of root holds the
+        /// condemned context's LoaderAllocator witness — managed reflection cannot enumerate raw
+        /// GCHandles, so the runtime classifies them here. This test drives the classification
+        /// end to end: a strong handle to an object of the collectible assembly must be counted
+        /// in the strong bucket (and must, by itself, keep the forced unload at NotQuiescent);
+        /// freeing it must drop the bucket back to baseline and let the teardown complete.
+        /// A weak-handle leg proves the buckets are distinguished by handle type rather than
+        /// lumped together.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleClassification_ReportsHoldingHandleByType()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                // Feature dark: the whole classification surface reports unavailable, exactly
+                // like the rest of the stats block.
+                Assert.Equal(-1, ScoutStats(CondemnedStrongHandles));
+                Assert.Equal(-1, ScoutStats(CondemnedPinnedHandles));
+                Assert.Equal(-1, ScoutStats(CondemnedWeakHandles));
+                Assert.Equal(-1, ScoutStats(CondemnedWeakTrackHandles));
+                Assert.Equal(-1, ScoutStats(CondemnedManagers));
+                Assert.Equal(-1, ScoutStats(CondemnedLiveWitnesses));
+                return;
+            }
+
+            // Baseline: no condemned context in scope, so every gauge reads zero.
+            Assert.Equal(0, ScoutStats(CondemnedManagers));
+            Assert.Equal(0, ScoutStats(CondemnedStrongHandles));
+            Assert.Equal(0, ScoutStats(CondemnedWeakHandles));
+            Assert.Equal(0, ScoutStats(CondemnedLiveWitnesses));
+
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            GCHandle strongHandle = default;
+            GCHandle weakHandle = default;
+            HandleCollectibleInstanceThenUnload(context, ref strongHandle, ref weakHandle);
+
+            GcQuiesce();
+
+            // The context is condemned (collectible + unloading) and its managers are in scope.
+            Assert.True(ScoutStats(CondemnedManagers) >= 1,
+                $"the unloading context's managers must be in scope (got {ScoutStats(CondemnedManagers)}).");
+
+            // The handles are classified by TYPE, not lumped: one strong and one weak handle
+            // target objects whose class lives in the collectible context.
+            Assert.True(ScoutStats(CondemnedStrongHandles) >= 1,
+                $"a strong GCHandle into the condemned set must be counted in the strong bucket " +
+                $"(got {ScoutStats(CondemnedStrongHandles)}; weak={ScoutStats(CondemnedWeakHandles)}, " +
+                $"managers={ScoutStats(CondemnedManagers)}).");
+            Assert.True(ScoutStats(CondemnedWeakHandles) >= 1,
+                $"a weak GCHandle into the condemned set must be counted in the weak bucket " +
+                $"(got {ScoutStats(CondemnedWeakHandles)}).");
+
+            // The strong handle is a real root: the witness stays alive and the teardown refuses.
+            Assert.True(ScoutStats(CondemnedLiveWitnesses) >= 1,
+                "the strong handle must keep the condemned context's LoaderAllocator witness alive.");
+            Assert.Equal(NotQuiescent, Force(context));
+
+            // Release every root: the buckets must drain and the teardown must now complete —
+            // proving the classification tracked the actual holder rather than a static shape.
+            strongHandle.Free();
+            weakHandle.Free();
+            s_weakHandleKeepAlive = null;
+            GcQuiesce();
+
+            Assert.Equal(0, ScoutStats(CondemnedStrongHandles));
+            Assert.Equal(0, ScoutStats(CondemnedWeakHandles));
+
+            Assert.Equal(Completed, await ForceUntilCompletedAsync(context, 10));
+
+            // Nothing condemned remains, so the whole surface returns to its baseline.
+            Assert.Equal(0, ScoutStats(CondemnedManagers));
+            Assert.Equal(0, ScoutStats(CondemnedLiveWitnesses));
+
+            context = null;
+            await CollectAndAssertDeadAsync(weakRef,
+                "the context must be reclaimable once the classified handles are freed.");
+        }
+
+        // Creates one instance of a type from the collectible assembly, roots it with a STRONG
+        // and a WEAK GCHandle (the classification targets), and initiates Unload. Every managed
+        // local is confined to this frame so the handles are the only roots the buckets can see.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static void HandleCollectibleInstanceThenUnload(
+            AssemblyLoadContext context, ref GCHandle strongHandle, ref GCHandle weakHandle)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            object strongTarget = Activator.CreateInstance(type);
+            object weakTarget = Activator.CreateInstance(type);
+            Assert.NotNull(strongTarget);
+            Assert.NotNull(weakTarget);
+
+            strongHandle = GCHandle.Alloc(strongTarget, GCHandleType.Normal);
+            weakHandle = GCHandle.Alloc(weakTarget, GCHandleType.Weak);
+            // A weak handle does not root its target, so the weak bucket could otherwise read 0
+            // simply because the target died before the assertions run. This static keeps it
+            // alive until the buckets have been observed; the test clears it before asserting
+            // the teardown completes (it is itself exactly the kind of static root under study).
+            s_weakHandleKeepAlive = weakTarget;
+
+            context.Unload();
+        }
+
+        // See HandleCollectibleInstanceThenUnload: keeps the weak-handle target observable.
+        private static object s_weakHandleKeepAlive;
