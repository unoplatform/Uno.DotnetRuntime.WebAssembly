 retired_scout_targets_add (MonoMemoryManager *memory_manager)
 {
@@ -666,6 +755,21 @@ ves_icall_System_Runtime_Loader_AssemblyLoadContext_InternalGetScoutRetirementSt
 	 * re-registered. Behind the DISABLE_THREADS gate like kinds 0/1. Distinguishes "the
 	 * scout ran and refused" from "the scout never ran": a never-dying witness climbs this
 	 * counter while kind 7 stays flat.
+	 *
+	 * Kinds 11-16 — ROOT CLASSIFICATION for the condemned set (see AlcCondemnedSet above).
+	 * All GAUGES, all behind the DISABLE_THREADS gate, all recomputed per read:
+	 *   11 — strong (Normal) GC handles whose target object belongs to a condemned context
+	 *   12 — pinned GC handles into the condemned set
+	 *   13 — weak (short) GC handles into the condemned set
+	 *   14 — weak-track-resurrection GC handles into the condemned set
+	 *   15 — condemned memory managers in scope (denominator; a context contributes its
+	 *        primary manager plus every shared generic manager it owns, so this is >= kind 8)
+	 *   16 — condemned managers whose LoaderAllocator witness is still alive
+	 * Read together they answer the question a managed root tracer cannot: when a host's
+	 * teardown reports NotQuiescent forever, a non-zero bucket names the handle class that
+	 * holds the witness, while all-zero buckets with kind 16 > 0 prove the holder is NOT a
+	 * GC handle at all — a thread stack/register or native structure — which is exactly the
+	 * elimination needed before instrumenting deeper.
 	 */
 	if (kind == 2 || kind == 3)
 		return mono_weak_hash_table_key_value_handle_stats (kind - 2);
@@ -701,6 +805,39 @@ ves_icall_System_Runtime_Loader_AssemblyLoadContext_InternalGetScoutRetirementSt
 		return collectible_alc_native_structs;
 	case 10:
 		return scout_completion_deferral_count;
+	case 11:
+	case 12:
+	case 13:
+	case 14: {
+		/* GC handles whose target lives in a condemned context, by handle type:
+		 * 11 = strong (Normal), 12 = pinned, 13 = weak, 14 = weak-track-resurrection. */
+		gint32 counts [4];
+		if (!alc_condemned_handle_counts (counts))
+			return -1;
+		return counts [kind - 11];
+	}
+	case 15: {
+		/* Condemned memory managers in scope — the denominator for kinds 11-14 and 16.
+		 * Differs from kind 8 (contexts): a context contributes its primary manager plus
+		 * every shared generic manager it owns. */
+		AlcCondemnedSet set;
+		alc_condemned_set_collect (&set);
+		gint32 result = (gint32)set.managers->len;
+		alc_condemned_set_free (&set);
+		return result;
+	}
+	case 16: {
+		/* Condemned managers whose LoaderAllocator witness is still alive — the exact
+		 * quantity the quiescence gate refuses on. Read together with kinds 11-14 it
+		 * separates "a GC handle holds the witness" (some bucket is non-zero) from "the
+		 * witness is held by a root the handle tables cannot see — thread stack,
+		 * register, or native structure" (every bucket zero while this is non-zero). */
+		AlcCondemnedSet set;
+		alc_condemned_set_collect (&set);
+		gint32 result = set.live_witnesses;
+		alc_condemned_set_free (&set);
+		return result;
+	}
 	default:
 		return -1;
 	}
