+        /// <summary>
+        /// ATOMICITY regression for the condemned-set snapshot.
+        ///
+        /// The tuple this surface reports is process-wide mutable state, and an earlier revision
+        /// delivered it as a dozen separate single-integer reads out of a process-global latch,
+        /// glued together by a caller-side refresh/read/validate token protocol. Two LOGICAL
+        /// callers were then enough to tear it, with no native thread race at all: A refreshed and
+        /// read one gauge, yielded, B refreshed, and A read the rest out of B's generation --
+        /// holding a tuple that never existed. That shape produced three separate defects in
+        /// review before it was replaced.
+        ///
+        /// The whole tuple now arrives from ONE call, so there is no "middle" for a competing
+        /// caller to splice into and a torn read is not a thing the surface can express. This test
+        /// pins that where it is observable -- at the boundary:
+        ///   * a returned tuple is a VALUE, not a window onto runtime state: a competing caller's
+        ///     snapshot, and a real change to the condemned set, must not retroactively alter a
+        ///     tuple that was already returned;
+        ///   * the newer tuple must see the change, so the previous assertion is not passing
+        ///     merely because nothing moved;
+        ///   * every tuple is INTERNALLY COHERENT -- visited &lt;= eligible, live witnesses &lt;=
+        ///     managers in scope, and the saturation flag agreeing with the visited/eligible pair.
+        ///     Those are exactly the cross-field invariants a mixed-generation read used to be
+        ///     able to violate, and they are checked on both tuples.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedSnapshot_SingleCallTuple_CannotBeTornByACompetingCaller()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            GCHandle first = default;
+            GCHandle second = default;
+
+            bool bodySucceeded = false;
+            try
+            {
+                first = RootCollectibleInstance(context);
+                GcQuiesce();
+
+                int[] before = CondemnedSnapshot();
+                AssertSnapshotIsCoherent(before);
+                Assert.True(before[CondemnedStrongHandles] > 0,
+                    $"the strong handle rooting the collectible instance must be attributed " +
+                    $"(strong={before[CondemnedStrongHandles]}).");
+
+                // Snapshot the tuple's own value, so "did the ALREADY RETURNED array change?" is
+                // answerable at all. A competing caller then takes its own snapshot AND the
+                // condemned set really moves underneath both of them.
+                int strongBefore = before[CondemnedStrongHandles];
+                int identityBefore = before[CondemnedIdentityHandles];
+
+                // A SECOND handle onto the same instance: counting is per HANDLE, so this moves the
+                // strong bucket by exactly one without needing a second collectible object.
+                second = GCHandle.Alloc(first.Target, GCHandleType.Normal);
+                int[] competing = CondemnedSnapshot();
+
+                // THE PROPERTY: the earlier tuple is a value copy. Neither the competing call nor
+                // the state change may reach back into it.
+                Assert.Equal(strongBefore, before[CondemnedStrongHandles]);
+                Assert.Equal(identityBefore, before[CondemnedIdentityHandles]);
+
+                // ...and the newer tuple DID see the change, so the assertion above is not passing
+                // vacuously on a surface that reports nothing at all.
+                Assert.Equal(strongBefore + 1, competing[CondemnedStrongHandles]);
+                AssertSnapshotIsCoherent(competing);
+
+                // Releasing the second handle brings the bucket back down by exactly one, and the
+                // tuple taken across that change is coherent too.
+                second.Free();
+                GcQuiesce();
+                int[] after = CondemnedSnapshot();
+                AssertSnapshotIsCoherent(after);
+                Assert.Equal(strongBefore, after[CondemnedStrongHandles]);
+                Assert.Equal(strongBefore + 1, competing[CondemnedStrongHandles]);
+
+                bodySucceeded = true;
+            }
+            finally
+            {
+                // Unconditional: a collectible+unloading context left pending would corrupt every
+                // later test in this serialized collection that asserts an exact gauge.
+                if (second.IsAllocated)
+                {
+                    second.Free();
+                }
+
+                if (first.IsAllocated)
+                {
+                    first.Free();
+                }
+
+                GcQuiesce();
+                int outcome = await ForceUntilCompletedAsync(context, 10);
+                context = null;
+
+                if (bodySucceeded)
+                {
+                    Assert.Equal(Completed, outcome);
+                    await CollectAndAssertDeadAsync(weakRef,
+                        "the context must be reclaimable once the rooting handles are freed.");
+                }
+            }
+        }
+
+        /// <summary>
+        /// BUFFER CONTRACT regression for the condemned-set snapshot (see the contract block in
+        /// assembly-load-context.c). The fill is ALL-OR-NOTHING, which is what makes a rejected
+        /// call safe: a caller's stale buffer stays stale rather than half-updated, so a partially
+        /// written tuple -- the very thing the single-call shape exists to make impossible -- can
+        /// never be observed either.
+        ///
+        /// Every buffer here is poisoned first, so "the runtime wrote this" and "the runtime left
+        /// this alone" are distinguishable; 0 would not be, since 0 is a legitimate value for every
+        /// count in the tuple. The test then requires:
+        ///   * an UNDERSIZED buffer to be refused with 0 and left completely untouched;
+        ///   * an OVERSIZED buffer to receive EXACTLY the tuple, with the tail still poisoned --
+        ///     so the fill honours the caller's length as a bound rather than assuming it;
+        ///   * a threads-enabled runtime to report -1 (UNAVAILABLE, never 0) and write nothing;
+        ///   * an absurd slot budget to be HANDLED rather than propagated -- the call still
+        ///     succeeds and still returns a coherent tuple. Deliberately NOT stated as "the clamp
+        ///     is proven": see the scope note at that assertion for what it does and does not
+        ///     establish.
+        ///
+        /// Keyed off PlatformDetection rather than off the call under test: deriving the
+        /// expectation from the same call would be self-confirming, since a regression that made
+        /// the surface report -1 everywhere would satisfy a self-derived expectation vacuously.
+        /// </summary>
+        [Fact]
+        public void CondemnedSnapshot_BufferContract_IsAllOrNothing()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            // An undersized buffer is refused on EVERY leg, threads-enabled included: the length
+            // check is part of the call's contract, not of the feature behind it.
+            int[] tooSmall = NewPoisonedSnapshotBuffer(CondemnedFieldCount - 1);
+            int shortResult = FillCondemnedSnapshot(tooSmall, CondemnedDefaultSlotBudget);
+            Assert.True(shortResult <= 0,
+                $"an undersized buffer must never report a successful fill (returned {shortResult}).");
+            AssertAllPoison(tooSmall, "an undersized buffer must be left completely untouched.");
+
+            int[] empty = new int[0];
+            Assert.True(FillCondemnedSnapshot(empty, CondemnedDefaultSlotBudget) <= 0,
+                "a zero-length buffer must never report a successful fill.");
+
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // Compiled out by the DISABLE_THREADS hard gate: UNAVAILABLE, and nothing written.
+                int[] dark = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+                Assert.Equal(-1, FillCondemnedSnapshot(dark, CondemnedDefaultSlotBudget));
+                AssertAllPoison(dark, "an unavailable surface must write nothing at all.");
+                return;
+            }
+
+            // Live on BOTH single-threaded legs: the buffer protocol is a property of the call, not
+            // of whether anything is currently condemned. Here the refusal is exactly 0 -- "too
+            // small", which is distinct from the -1 the threads leg above reports for UNAVAILABLE.
+            Assert.Equal(0, shortResult);
+
+            const int Slack = 4;
+            int[] oversized = NewPoisonedSnapshotBuffer(CondemnedFieldCount + Slack);
+            Assert.Equal(CondemnedFieldCount, FillCondemnedSnapshot(oversized, CondemnedDefaultSlotBudget));
+
+            for (int i = 0; i < CondemnedFieldCount; i++)
+            {
+                Assert.NotEqual(SnapshotPoison, oversized[i]);
+            }
+
+            // THE BOUND: everything past the tuple is still poison, so the fill wrote exactly the
+            // fields it declared and no more.
+            for (int i = CondemnedFieldCount; i < oversized.Length; i++)
+            {
+                Assert.Equal(SnapshotPoison, oversized[i]);
+            }
+
+            // An exact-size buffer is the ordinary case and must succeed identically.
+            int[] exact = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+            Assert.Equal(CondemnedFieldCount, FillCondemnedSnapshot(exact, CondemnedDefaultSlotBudget));
+            AssertSnapshotIsCoherent(exact);
+
+            // THE BUDGET IS A REQUEST, NOT A COMMAND -- with the scope of that stated plainly,
+            // because it is tempting to overclaim here. What this pins is that an absurd budget is
+            // HANDLED: the call still succeeds, still returns a coherent tuple, and nothing
+            // overflows on the way (int.MaxValue is the interesting value for that). It does NOT
+            // prove the clamp itself. Observing the clamp would need a handle table with more raw
+            // slots than the runtime's own cap, which no test can build cheaply -- so the clamp,
+            // like the sweep in sgen_gchandle_foreach_slot_bounded, rests on review of a single
+            // expression rather than on a regression.
+            int[] greedy = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+            Assert.Equal(CondemnedFieldCount, FillCondemnedSnapshot(greedy, int.MaxValue));
+            AssertSnapshotIsCoherent(greedy);
+
+            // A negative budget means "use the default" rather than "walk nothing" or "abort".
+            int[] negative = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+            Assert.Equal(CondemnedFieldCount, FillCondemnedSnapshot(negative, -1));
+            AssertSnapshotIsCoherent(negative);
+        }
+
+        /// <summary>
+        /// POSITIVE saturation regression for CondemnedWalkSaturated. Every other assertion in this
+        /// suite requires that flag to be 0, so a runtime that never set it at all would stay green;
+        /// this one requires it to be SET, on a table deliberately pushed past a raw-slot budget the
+        /// test itself asks for.
+        ///
+        /// It also pins what saturation MEANS: truncated counts are LOWER BOUNDS, so they can
+        /// never exceed the same reading taken under the full budget.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleWalk_SaturationFlag_IsSetWhenTheRawBudgetIsCrossed()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            await WithHoleyHandleTableAsync((full, selfTest) =>
+            {
+                // The real 200k budget is nowhere near crossed by a healthy runtime, and the full
+                // walk really did find the rooting handle -- without which the comparison below
+                // would be a statement about two empty readings.
+                Assert.Equal(0, full[CondemnedWalkSaturated]);
+                Assert.True(full[CondemnedStrongHandles] > 0,
+                    $"the unbudgeted walk must attribute the strong handle holding the condemned " +
+                    $"instance (strong={full[CondemnedStrongHandles]}).");
+
+                // THE POSITIVE BRANCH: the reduced cap IS crossed and the flag says so.
+                Assert.Equal(1, selfTest[CondemnedWalkSaturated]);
+
+                // A saturated read may only UNDERSTATE. Deliberately stated as a weak
+                // monotonicity check, and worth being explicit about why it cannot be stronger:
+                // the surviving window is the LOW slots, which belong to the runtime's own
+                // long-lived handles, while sgen places new handles from slot_hint upward -- so
+                // after the inflation this test's own rooting handle is far above the cap and a
+                // truncated bucket legitimately reads 0. "0 <= 1" is all that is provable here;
+                // the load-bearing truncation assertions are the saturation flag above, and the
+                // visited/eligible pair in
+                // CondemnedHandleWalk_RawSlotBudget_StopsShortOfAHoleyTablesHighWaterMark.
+                Assert.True(selfTest[CondemnedStrongHandles] <= full[CondemnedStrongHandles],
+                    $"a truncated walk's counts are lower bounds " +
+                    $"(selfTest={selfTest[CondemnedStrongHandles]}, full={full[CondemnedStrongHandles]}).");
+                Assert.True(selfTest[CondemnedIdentityHandles] <= full[CondemnedIdentityHandles],
+                    $"a truncated walk's identity count is a lower bound " +
+                    $"(selfTest={selfTest[CondemnedIdentityHandles]}, full={full[CondemnedIdentityHandles]}).");
+
+                // Set-wide gauges are computed outside the handle walk, so truncation must not
+                // INVENT condemned managers: saturation is about the walk, not about the set.
+                // Deliberately <= rather than equality, exactly as elsewhere in this suite: the
+                // GC-driven scout completion can retire a stray an earlier test left pending
+                // between the two snapshots, which would make an equality order-dependent.
+                Assert.True(selfTest[CondemnedManagers] > 0,
+                    "the budgeted snapshot must still see the condemned context's managers.");
+                Assert.True(selfTest[CondemnedManagers] <= full[CondemnedManagers],
+                    $"a truncated handle walk must not grow the condemned manager set " +
+                    $"(full={full[CondemnedManagers]}, selfTest={selfTest[CondemnedManagers]}).");
+            });
+        }
+
+        /// <summary>
+        /// Raw-slot bound regression (visited versus eligible) on a HOLEY table -- the shape a
+        /// classification-only budget cannot bound.
+        ///
+        /// Each sgen handle table is an SgenArrayList whose next_slot is a persistent high-water
+        /// mark: freeing a handle only NULLs its slot, and refills reuse holes, so the mark never
+        /// comes back down. A budget that merely skipped per-slot classification work would
+        /// therefore still sweep every slot of a long, mostly-empty table, once per handle type,
+        /// while every bucket reported 0. On a single browser thread that is a pause, not just
+        /// wasted work.
+        ///
+        /// So: inflate the strong-handle table's high-water mark far past the requested cap, free
+        /// every one of those handles to leave it holey, and require the walk to stop AT the cap
+        /// rather than at the mark.
+        ///
+        /// SCOPE OF THIS PROOF, stated plainly rather than overclaimed. Kind 21 is the runtime's
+        /// own report of how many slots it loaded, and it is the only channel there is -- so this
+        /// test pins the REPORTED bound, not the sweep. A probe that walked the whole table while
+        /// still reporting the cap passed this suite unchanged; the sweep itself is guaranteed by
+        /// the loop's range expression in sgen_gchandle_foreach_slot_bounded, which is a matter for
+        /// review. What this test does catch is the shape it replaced, where the budget gated only
+        /// per-slot classification and left the reported range at the table's high-water mark.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleWalk_RawSlotBudget_StopsShortOfAHoleyTablesHighWaterMark()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            await WithHoleyHandleTableAsync((full, selfTest) =>
+            {
+                // The scanned range really is long. Kind 22 sums the high-water marks of all FOUR
+                // scanned tables, so this does not attribute the length to the strong-handle table
+                // specifically -- but it does not need to: HoleyTableInflation simultaneously live
+                // Normal handles occupy that many distinct indices, so that table's mark alone is
+                // >= HoleyTableInflation and the sum can only be larger. (A DELTA across the
+                // inflation would be the attributing form but is NOT sound: sgen refills holes via
+                // sgen_array_list_find_unset, so if the table already had enough holes the mark
+                // legitimately does not move at all.)
+                Assert.True(full[CondemnedSlotsEligible] >= HoleyTableInflation,
+                    $"the inflated strong-handle table must leave the scanned high-water mark at " +
+                    $"least {HoleyTableInflation} raw slots (eligible={full[CondemnedSlotsEligible]}).");
+
+                // A high-water mark never comes back down, so the second snapshot's eligible range
+                // can only be >= the first's (>= rather than == because the two icall sweeps
+                // themselves may allocate a handle the runtime places past a table's mark).
+                Assert.True(selfTest[CondemnedSlotsEligible] >= full[CondemnedSlotsEligible],
+                    $"a table's high-water mark must never shrink " +
+                    $"(full={full[CondemnedSlotsEligible]}, selfTest={selfTest[CondemnedSlotsEligible]}).");
+
+                // The unbudgeted walk covers that whole range -- which is what makes the next
+                // assertion a statement about the CAP and not about an empty table.
+                Assert.Equal(full[CondemnedSlotsEligible], full[CondemnedSlotsVisited]);
+                Assert.True(full[CondemnedSlotsVisited] > CondemnedTestSlotBudget,
+                    $"the eligible range must exceed the requested cap for this to be a bound " +
+                    $"(visited={full[CondemnedSlotsVisited]}, cap={CondemnedTestSlotBudget}).");
+
+                // THE PROPERTY UNDER TEST: the walk reports having stopped at the RAW slot cap,
+                // far short of the mark it was eligible to cover. See the SCOPE note above for
+                // what this does and does not establish.
+                Assert.True(selfTest[CondemnedSlotsVisited] > 0,
+                    "the budgeted walk must still have loaded slots: a walk that ran not at " +
+                    "all would satisfy the cap vacuously.");
+                Assert.True(selfTest[CondemnedSlotsVisited] <= CondemnedTestSlotBudget,
+                    $"the walk must stop at its raw-slot cap, not at the table's high-water mark " +
+                    $"(visited={selfTest[CondemnedSlotsVisited]}, cap={CondemnedTestSlotBudget}, " +
+                    $"eligible={selfTest[CondemnedSlotsEligible]}).");
+                Assert.True(selfTest[CondemnedSlotsVisited] < selfTest[CondemnedSlotsEligible],
+                    $"the budgeted walk must have left slots unvisited " +
+                    $"(visited={selfTest[CondemnedSlotsVisited]}, eligible={selfTest[CondemnedSlotsEligible]}).");
+            });
+        }
+
+        // Builds the shape both raw-walk regressions need -- a CONDEMNED context, so the walk runs
+        // at all, plus a strong-handle table whose persistent high-water mark is far above the
+        // requested cap while nearly every slot in it is a hole -- takes one default-budget
+        // snapshot and one reduced-budget snapshot of that state, hands both to `assert`, and drains the
+        // context so no later test's gauges are polluted.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static async Task WithHoleyHandleTableAsync(Action<int[], int[]> assert)
+        {
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            GCHandle root = default;
+
+            bool bodySucceeded = false;
+            try
+            {
+                root = RootCollectibleInstanceAndInflateHandleTable(context);
+
+                // Both snapshots describe the SAME state: nothing between them allocates or frees
+                // a handle, so the only difference is the raw-slot cap they were taken under.
+                int[] full = CondemnedSnapshot();
+                int[] selfTest = CondemnedSnapshot(CondemnedTestSlotBudget);
+                assert(full, selfTest);
+                bodySucceeded = true;
+            }
+            finally
+            {
+                // The drain runs UNCONDITIONALLY, from the finally: a failing assertion above must
+                // not skip it. Leaving a collectible+unloading context pending would break every
+                // later test in this serialized collection that asserts an exact gauge, turning
+                // one real failure into a spray of order-dependent ones.
+                if (root.IsAllocated)
+                {
+                    root.Free();
+                }
+
+                GcQuiesce();
+                int outcome = await ForceUntilCompletedAsync(context, 10);
+                context = null;
+
+                // ...but its OUTCOME is only asserted when the body succeeded. An assertion thrown
+                // from a finally block replaces the in-flight one, which would hide the real
+                // failure behind a teardown symptom.
+                if (bodySucceeded)
+                {
+                    Assert.Equal(Completed, outcome);
+                    await CollectAndAssertDeadAsync(weakRef,
+                        "the context must be reclaimable once the rooting handle is freed.");
+                }
+            }
+        }
+
+        // Roots one instance out of the collectible context with a strong handle (so the context
+        // stays condemned and the walk has something to attribute), then inflates the strong-handle
+        // table's high-water mark and punches it full of holes.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static GCHandle RootCollectibleInstanceAndInflateHandleTable(AssemblyLoadContext context)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            object target = Activator.CreateInstance(type);
+            Assert.NotNull(target);
+
+            context.Unload();
+
+            // HoleyTableInflation simultaneously LIVE handles must occupy that many DISTINCT slots
+            // below the table's next_slot, so the mark is at least that high while they exist.
+            // Freeing them all then leaves the mark exactly where it was (sgen only NULLs the
+            // slot), producing a table that is long and nearly empty. That is precisely the shape a
+            // budget on classified hits walks end to end.
+            var filler = new GCHandle[HoleyTableInflation];
+            try
+            {
+                for (int i = 0; i < filler.Length; i++)
+                {
+                    filler[i] = GCHandle.Alloc(new object(), GCHandleType.Normal);
+                }
+            }
+            finally
+            {
+                for (int i = 0; i < filler.Length; i++)
+                {
+                    if (filler[i].IsAllocated)
+                    {
+                        filler[i].Free();
+                    }
+                }
+            }
+
+            return GCHandle.Alloc(target, GCHandleType.Normal);
+        }
+
+        // Slots of the handle array driven by CondemnedHandleClassification_ReportsHoldingHandleByType.
+        private const int HandleStrong = 0;
+        private const int HandlePinned = 1;
+        private const int HandleWeak = 2;
+        private const int HandleWeakTrack = 3;
+        private const int HandleNegativePlain = 4;
+        private const int HandleNegativeContainer = 5;
+        private const int HandleSlotCount = 6;
+
+        // Takes ONE condemned-set snapshot and returns it, indexed by the field constants above.
+        //
+        // There is no retry loop, no generation token and no read protocol, because there is
+        // nothing to protect: the whole tuple is filled by a single call, so a competing caller
+        // cannot replace half of it. (The multi-read protocol this replaced, and why it kept
+        // producing defects, are recorded in the contract block in assembly-load-context.c.)
+        //
+        // `slotBudget` is the caller's raw-slot cost knob; the default asks the runtime for its own
+        // budget. The buffer is poisoned first so a fill that silently skipped a field would be
+        // caught here rather than showing up as a mysterious 0 in an assertion downstream.
+        private static int[] CondemnedSnapshot(int slotBudget = CondemnedDefaultSlotBudget)
+        {
+            int[] buffer = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+            Assert.Equal(CondemnedFieldCount, FillCondemnedSnapshot(buffer, slotBudget));
+            for (int i = 0; i < buffer.Length; i++)
+            {
+                Assert.NotEqual(SnapshotPoison, buffer[i]);
+            }
+
+            return buffer;
+        }
+
+        private static int[] NewPoisonedSnapshotBuffer(int length)
+        {
+            int[] buffer = new int[length];
+            for (int i = 0; i < buffer.Length; i++)
+            {
+                buffer[i] = SnapshotPoison;
+            }
+
+            return buffer;
+        }
+
+        private static void AssertAllPoison(int[] buffer, string because)
+        {
+            for (int i = 0; i < buffer.Length; i++)
+            {
+                Assert.True(buffer[i] == SnapshotPoison, $"{because} (index {i} = {buffer[i]}).");
+            }
+        }
+
+        private static int FillCondemnedSnapshot(int[] buffer, int slotBudget)
+            => (int)s_getCondemnedSnapshot.Invoke(null, new object[] { buffer, slotBudget });
+
+        // The cross-field invariants a SINGLE tuple must satisfy. These are exactly the ones a
+        // mixed-generation read used to be able to violate -- fields from two different states of
+        // the world can contradict each other, fields from one state cannot -- so asserting them on
+        // every tuple this suite takes is how "the tuple is one state of the world" stays checked
+        // rather than merely claimed.
+        private static void AssertSnapshotIsCoherent(int[] snapshot)
+        {
+            Assert.True(snapshot[CondemnedLiveWitnesses] <= snapshot[CondemnedManagers],
+                $"live witnesses cannot exceed the managers in scope they are counted from " +
+                $"(witnesses={snapshot[CondemnedLiveWitnesses]}, managers={snapshot[CondemnedManagers]}).");
+
+            if (snapshot[CondemnedSlotsEligible] < 0)
+            {
+                // Non-sgen collector: the walk cannot run, so every field that depends on it
+                // reports UNAVAILABLE -- as a GROUP, never a mix of -1 and a misleading 0.
+                Assert.Equal(-1, snapshot[CondemnedStrongHandles]);
+                Assert.Equal(-1, snapshot[CondemnedPinnedHandles]);
+                Assert.Equal(-1, snapshot[CondemnedWeakHandles]);
+                Assert.Equal(-1, snapshot[CondemnedWeakTrackHandles]);
+                Assert.Equal(-1, snapshot[CondemnedIdentityHandles]);
+                Assert.Equal(-1, snapshot[CondemnedSlotsVisited]);
+                Assert.Equal(-1, snapshot[CondemnedWalkSaturated]);
+                return;
+            }
+
+            Assert.True(snapshot[CondemnedSlotsVisited] <= snapshot[CondemnedSlotsEligible],
+                $"the walk cannot visit more raw slots than it was eligible to visit " +
+                $"(visited={snapshot[CondemnedSlotsVisited]}, eligible={snapshot[CondemnedSlotsEligible]}).");
+
+            // The saturation flag is not an independent value: it means precisely "the walk stopped
+            // short", so it must agree with the pair that reports where it stopped, in BOTH
+            // directions. A flag that were merely set optimistically, or never set at all, fails
+            // one direction or the other.
+            Assert.Equal(
+                snapshot[CondemnedSlotsVisited] < snapshot[CondemnedSlotsEligible] ? 1 : 0,
+                snapshot[CondemnedWalkSaturated]);
+        }
+
+        // Both dark configurations, keyed off the PLATFORM rather than off the call under test:
+        // deriving the expectation from the same call would be self-confirming -- a regression that
+        // made the whole surface report -1 would satisfy both dark legs vacuously.
+        private static void AssertClassificationDarkSurface()
+        {
+            int[] buffer = NewPoisonedSnapshotBuffer(CondemnedFieldCount);
+
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // The forced-unload machinery, and this surface with it, is compiled out by the
+                // DISABLE_THREADS hard gate: the call must report UNAVAILABLE and write NOTHING --
+                // never a tuple of zeroes, which would read as "measured, and found nothing".
+                Assert.Equal(-1, FillCondemnedSnapshot(buffer, CondemnedDefaultSlotBudget));
+                AssertAllPoison(buffer, "a surface compiled out by DISABLE_THREADS must write nothing.");
+                return;
+            }
+
+            // Single-threaded with the opt-in off: the surface is LIVE -- the call succeeds and
+            // fills the whole tuple -- but nothing is natively collectible, so the condemned set is
+            // genuinely EMPTY and every field honestly reads 0.
+            int[] snapshot = CondemnedSnapshot();
+            AssertSnapshotIsCoherent(snapshot);
+            for (int i = 0; i < snapshot.Length; i++)
+            {
+                Assert.True(snapshot[i] == 0,
+                    $"an empty condemned set must report 0, not {snapshot[i]}, in field {i}.");
+            }
+
+            // The tiny budget is live here too. With an EMPTY condemned set the handle walk is
+            // skipped entirely, so it can neither visit a slot nor saturate -- a small budget does
+            // not manufacture truncation out of a walk that never ran.
+            int[] budgeted = CondemnedSnapshot(CondemnedTestSlotBudget);
+            AssertSnapshotIsCoherent(budgeted);
+            Assert.Equal(0, budgeted[CondemnedWalkSaturated]);
+            Assert.Equal(0, budgeted[CondemnedSlotsVisited]);
+            Assert.Equal(0, budgeted[CondemnedSlotsEligible]);
+        }
+
+        // Loads the collectible assembly, creates one instance, unloads, and roots the instance
+        // with a strong handle so the context stays condemned with something attributable in it.
+        // Deliberately NOT shared with RootCollectibleInstanceAndInflateHandleTable: there the
+        // rooting handle must be allocated AFTER the table inflation so it lands above the cap,
+        // and that ordering is the point of that helper rather than an incidental detail.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static GCHandle RootCollectibleInstance(AssemblyLoadContext context)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            object target = Activator.CreateInstance(type);
+            Assert.NotNull(target);
+
+            context.Unload();
+            return GCHandle.Alloc(target, GCHandleType.Normal);
+        }
+
+        // Loads the collectible assembly, creates the two probe instances, unloads, and then
+        // allocates the classified handles in four tight phases -- asserting EXACT bucket deltas
+        // across each, including a +1/-1 pair on the identity bucket. Everything managed stays
+        // confined to this frame so the GCHandles are the only roots the buckets can attribute,
+        // and each measurement interval contains nothing but the GCHandle.Alloc calls under test,
+        // which is what makes the deltas exact rather than merely monotone. Returns the baseline
+        // snapshot for the caller's later phases.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static int[] RootCollectibleInstancesWithClassifiedHandles(
+            AssemblyLoadContext context, GCHandle[] handles)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            Type pointerFreeType = asm.GetType(PointerFreeClassName, throwOnError: true);
+            object strongTarget = Activator.CreateInstance(type);
+
+            // PointerFreeTestClass has no reference fields, so an instance of it is PINNABLE --
+            // which is what lets the pinned and weak-track buckets be exercised with real handles instead of being
+            // asserted to stay at zero.
+            object pinnedTarget = Activator.CreateInstance(pointerFreeType);
+            Assert.NotNull(strongTarget);
+            Assert.NotNull(pinnedTarget);
+
+            context.Unload();
+
+            // BASELINE: the context is already condemned (collectible + unloading) and its
+            // managers are in scope, but none of this test's handles exist yet.
+            int[] before = CondemnedSnapshot();
+            Assert.True(before[CondemnedManagers] > 0,
+                $"the unloading context's memory managers must enter the condemned set " +
+                $"(managers={before[CondemnedManagers]}).");
+            Assert.True(before[CondemnedLiveWitnesses] > 0,
+                $"an unloading context with live instances must still have a live LoaderAllocator " +
+                $"witness (witnesses={before[CondemnedLiveWitnesses]}).");
+            Assert.Equal(0, before[CondemnedWalkSaturated]);
+
+            // The runtime's OWN roots are already attributable -- but only by IDENTITY: the
+            // managed wrapper (which PrepareForAssemblyLoadContextRelease promoted to a STRONG
+            // handle when Unload was requested) and the LoaderAllocator witness are both
+            // corelib-classed, so the class buckets are blind to them by construction. Asserting this
+            // documents why the type buckets alone would under-report the real root set.
+            Assert.True(before[CondemnedIdentityHandles] >= 2,
+                $"the runtime's own wrapper and witness handles must be identity-attributed " +
+                $"(identity={before[CondemnedIdentityHandles]}, strong={before[CondemnedStrongHandles]}).");
+
+            // PHASE A -- strong and weak only. The +0 on the untouched buckets is the load-bearing
+            // half: it proves the buckets are separated by handle TYPE rather than lumped.
+            handles[HandleStrong] = GCHandle.Alloc(strongTarget, GCHandleType.Normal);
+            handles[HandleWeak] = GCHandle.Alloc(pinnedTarget, GCHandleType.Weak);
+            AssertBucketDeltas(before, CondemnedSnapshot(), 1, 0, 1, 0);
+
+            // PHASE B -- add the pinned and weak-track handles. Both target the pointer-free
+            // instance, which the pinned handle also keeps observable for the weak buckets: the
+            // previous shape used a static for that, and a static is a second STRONG root, so it
+            // made "the strong handle alone holds the witness" unprovable.
+            handles[HandlePinned] = GCHandle.Alloc(pinnedTarget, GCHandleType.Pinned);
+            handles[HandleWeakTrack] = GCHandle.Alloc(pinnedTarget, GCHandleType.WeakTrackResurrection);
+            int[] afterB = CondemnedSnapshot();
+            AssertBucketDeltas(before, afterB, 1, 1, 1, 1);
+
+            // NEGATIVE CONTROLS. (1) A handle on a plain corelib object must move nothing -- the
+            // walk is not counting handles indiscriminately. (2) A handle on an object[] HOLDING
+            // the collectible instance must ALSO move nothing: the array is corelib-classed, so
+            // one-hop class attribution cannot see the condemned instance it roots. That second
+            // zero is the documented blind spot of this diagnostic, asserted rather than assumed.
+            handles[HandleNegativePlain] = GCHandle.Alloc(new object(), GCHandleType.Normal);
+            handles[HandleNegativeContainer] = GCHandle.Alloc(new object[] { strongTarget }, GCHandleType.Normal);
+            int[] afterControls = CondemnedSnapshot();
+            AssertBucketDeltas(before, afterControls, 1, 1, 1, 1);
+            Assert.Equal(afterB[CondemnedManagers], afterControls[CondemnedManagers]);
+
+            // IDENTITY ATTRIBUTION COUNTS HANDLES, NOT DISTINCT OBJECTS. `context` is ALREADY in
+            // the identity set -- the runtime's own strong handle targets it -- so a SECOND handle
+            // onto the very same object must still move the identity count by exactly +1, and back by exactly
+            // -1 when freed. That +1/-1 pair is what separates per-handle counting from
+            // unique-object counting: an implementation that reported the size of the identity set
+            // would satisfy "identity >= 2" above and never move here at all.
+            //
+            // Kinds 11-14 must stay FLAT across the same interval: identity attribution is checked
+            // first and is class-blind, and the wrapper's own class lives in the (non-collectible)
+            // default context anyway, so no class bucket may claim this handle.
+            var identityHandle = GCHandle.Alloc(context, GCHandleType.Normal);
+            int[] afterIdentity;
+            try
+            {
+                afterIdentity = CondemnedSnapshot();
+
+                // Asserted FIRST so that a change in the identity SET (rather than in the number
+                // of handles into it) is attributed to its real cause instead of showing up as a
+                // mysterious identity-count delta.
+                Assert.Equal(afterControls[CondemnedLiveWitnesses], afterIdentity[CondemnedLiveWitnesses]);
+                Assert.Equal(afterControls[CondemnedIdentityHandles] + 1, afterIdentity[CondemnedIdentityHandles]);
+                AssertBucketDeltas(afterControls, afterIdentity, 0, 0, 0, 0);
+            }
+            finally
+            {
+                identityHandle.Free();
+            }
+
+            int[] afterIdentityFreed = CondemnedSnapshot();
+
+            // Same stability guard as the +1 direction, for the same reason: the identity count counts
+            // handles onto ANY member of the identity set, so a shared-generic witness dying in
+            // this window would move it for a reason that has nothing to do with handle counting.
+            // Without this the -1 assertion could fail as "expected N-1, got N-2" and point at
+            // the wrong thing.
+            Assert.Equal(afterIdentity[CondemnedLiveWitnesses], afterIdentityFreed[CondemnedLiveWitnesses]);
+            Assert.Equal(afterIdentity[CondemnedManagers], afterIdentityFreed[CondemnedManagers]);
+            Assert.Equal(afterIdentity[CondemnedIdentityHandles] - 1, afterIdentityFreed[CondemnedIdentityHandles]);
+            AssertBucketDeltas(before, afterIdentityFreed, 1, 1, 1, 1);
+
+            GC.KeepAlive(strongTarget);
+            GC.KeepAlive(pinnedTarget);
+            return before;
+        }
+
+        // Exact per-bucket deltas between two snapshots of the classification surface.
+        private static void AssertBucketDeltas(
+            int[] before, int[] after, int strong, int pinned, int weak, int weakTrack)
+        {
+            Assert.Equal(before[CondemnedStrongHandles] + strong, after[CondemnedStrongHandles]);
+            Assert.Equal(before[CondemnedPinnedHandles] + pinned, after[CondemnedPinnedHandles]);
+            Assert.Equal(before[CondemnedWeakHandles] + weak, after[CondemnedWeakHandles]);
+            Assert.Equal(before[CondemnedWeakTrackHandles] + weakTrack, after[CondemnedWeakTrackHandles]);
+            Assert.Equal(0, after[CondemnedWalkSaturated]);
+        }
