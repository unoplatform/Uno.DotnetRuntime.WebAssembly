+ * There is no latch and no static state: every value below lives in this frame until it is
+ * copied out, which is what makes the tuple untearable and why this surface needs no read
+ * protocol. `slot_budget` is the caller's RAW-slot cap, clamped here so the walk's pause bound
+ * is a property of the surface rather than of the caller; <= 0 means "use the default".
+ *
+ * The identity set holds raw MonoObject* between the ALC-list walk and the handle walk: safe
+ * here and only here, because nothing in between allocates managed memory or reaches a
+ * safepoint (the set uses native malloc), and this build has no other thread that could start
+ * a collection -- so no object can be relocated mid-snapshot. Nothing retains those pointers
+ * past the return.
+ */
+static int
+alc_condemned_snapshot_fill (gint32 *fields, gint32 length, gint32 slot_budget)
+{
+	/* The four class buckets must be a contiguous run in sgen's table order, because the copy
+	 * below is a single loop over it, and the tuple must have room for every field. */
+	g_static_assert (ALC_SNAPSHOT_WEAK_TRACK_HANDLES - ALC_SNAPSHOT_STRONG_HANDLES + 1 == ALC_CONDEMNED_HANDLE_BUCKETS);
+	g_static_assert (ALC_SNAPSHOT_STRONG_HANDLES + ALC_CONDEMNED_HANDLE_BUCKETS <= ALC_SNAPSHOT_FIELD_COUNT);
+
+	if (!fields || length < ALC_SNAPSHOT_FIELD_COUNT)
+		return 0;
+
+	AlcCondemnedSetBuild build;
+	build.managers = g_hash_table_new (g_direct_hash, g_direct_equal);
+	build.witness_objects = g_hash_table_new (g_direct_hash, g_direct_equal);
+	build.managers_in_scope = 0;
+	build.live_witnesses = 0;
+
+	alcs_lock ();
+	for (GSList *tmp = alcs; tmp; tmp = tmp->next) {
+		MonoAssemblyLoadContext *alc = (MonoAssemblyLoadContext *)tmp->data;
+		if (!alc_is_condemned (alc))
+			continue;
+
+		/* The managed wrapper: PrepareForAssemblyLoadContextRelease swapped this handle to
+		 * STRONG when the unload was requested, so it is a real root -- and corelib-classed,
+		 * hence invisible to class attribution. Identity catches it. */
+		if (alc->gchandle) {
+			MonoObject *wrapper = (MonoObject *)mono_gchandle_get_target_internal (alc->gchandle);
+			if (wrapper)
+				g_hash_table_insert (build.witness_objects, wrapper, wrapper);
+		}
+
+		alc_foreach_teardown_manager (alc, alc_condemned_set_visit, &build);
+	}
+	alcs_unlock ();
+
+	fields [ALC_SNAPSHOT_MANAGERS_IN_SCOPE] = build.managers_in_scope;
+	fields [ALC_SNAPSHOT_LIVE_WITNESSES] = build.live_witnesses;
+
+#ifdef HAVE_SGEN_GC
+	/* The caller's cost knob, clamped: a smaller budget only truncates a read-only walk (and
+	 * says so through `saturated`), while a larger one must not be able to lift the pause
+	 * bound this surface promises. */
+	gint32 budget = (slot_budget <= 0 || slot_budget > ALC_CONDEMNED_HANDLE_SLOT_BUDGET)
+			? ALC_CONDEMNED_HANDLE_SLOT_BUDGET : slot_budget;
+
+	MonoSgenCondemnedHandleScan scan;
+	memset (&scan, 0, sizeof (scan));
+	scan.condemned_managers = build.managers;
+	scan.condemned_objects = build.witness_objects;
+	scan.slot_budget = budget;
+	sgen_scan_handles_into_managers (&scan);
+
+	for (int i = 0; i < ALC_CONDEMNED_HANDLE_BUCKETS; ++i)
+		fields [ALC_SNAPSHOT_STRONG_HANDLES + i] = scan.class_hits [i];
+	fields [ALC_SNAPSHOT_IDENTITY_HANDLES] = scan.identity_hits;
+	fields [ALC_SNAPSHOT_SLOTS_VISITED] = scan.slots_visited;
+	fields [ALC_SNAPSHOT_SLOTS_ELIGIBLE] = scan.slots_eligible;
+	fields [ALC_SNAPSHOT_SATURATED] = scan.saturated ? 1 : 0;
+#else
+	/* No sgen: the set-wide fields above are still honest, but nothing here can walk a handle
+	 * table, so the fields that depend on the walk report UNAVAILABLE rather than a 0 that
+	 * would read as "no such handle exists". */
+	(void)slot_budget;
+	for (int i = 0; i < ALC_CONDEMNED_HANDLE_BUCKETS; ++i)
+		fields [ALC_SNAPSHOT_STRONG_HANDLES + i] = -1;
+	fields [ALC_SNAPSHOT_IDENTITY_HANDLES] = -1;
+	fields [ALC_SNAPSHOT_SLOTS_VISITED] = -1;
+	fields [ALC_SNAPSHOT_SLOTS_ELIGIBLE] = -1;
+	fields [ALC_SNAPSHOT_SATURATED] = -1;
+#endif
+
+	g_hash_table_destroy (build.witness_objects);
+	g_hash_table_destroy (build.managers);
+
+	return ALC_SNAPSHOT_FIELD_COUNT;
+}
