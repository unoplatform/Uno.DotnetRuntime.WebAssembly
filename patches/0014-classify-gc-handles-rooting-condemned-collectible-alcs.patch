+	 * afterwards); never retain this set across a GC. */
+	GHashTable *condemned_objects;
+	/* IN: cap on handle slots CLASSIFIED (<= 0 means no cap); past it counts are lower bounds
+	 * and `saturated` is set. */
+	gint32 slot_budget;
+
+	/* OUT: handles whose target's CLASS belongs to condemned_managers, per handle type, in the
+	 * order { strong (Normal), pinned, weak (short), weak-track-resurrection }. */
+	gint32 class_hits [MONO_SGEN_CONDEMNED_HANDLE_BUCKETS];
+	/* OUT: handles of ANY type whose target IS a member of condemned_objects. */
+	gint32 identity_hits;
+	/* OUT: handle slots visited, and whether slot_budget cut the classification short. */
+	gint32 slots_visited;
+	gboolean saturated;
+} MonoSgenCondemnedHandleScan;
+
+void sgen_scan_handles_into_managers (MonoSgenCondemnedHandleScan *scan);
+#endif
+
 #endif /* __MONO_METADATA_GC_INTERNAL_H__ */
