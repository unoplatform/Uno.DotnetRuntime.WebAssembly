+        /// <summary>
+        /// Cross-caller atomicity regression for the split getter protocol (stats kinds 17/20).
+        ///
+        /// The gauges are separate icall reads that carry no generation of their own, so the single
+        /// process-global latch does NOT by itself make a multi-read atomic — and no native thread
+        /// race is needed to break it. Two LOGICAL callers suffice: A takes kind 17 and reads kind
+        /// 11, yields; B takes kind 17; A resumes and reads kind 12 out of B's generation. A now
+        /// holds a tuple that never existed, which is exactly the impossible combination the
+        /// consistency contract claims to prevent.
+        ///
+        /// This test pins the token that closes that hole:
+        ///   * kind 20 must be a PURE read — reading it repeatedly cannot advance the generation
+        ///     (a mutant that refreshes there destroys the only signal a reader has);
+        ///   * an UNINTERRUPTED gauge sweep must end with kind 20 still equal to what kind 17
+        ///     returned (a mutant where any gauge read refreshes the snapshot fails here);
+        ///   * a sweep with a competing kind 17 spliced into the MIDDLE must be REJECTED, not
+        ///     returned.
+        ///
+        /// Every token comparison here is DIFFERENCE, never ordering: the token wraps, so `&gt;`
+        /// would encode an ordering the runtime does not promise and does not have. The wrap
+        /// itself is driven by CondemnedSnapshot_GenerationTokenWrap_StillRejectsAMixedRead.
+        /// </summary>
+        [Fact]
+        public void CondemnedSnapshot_MixedGenerationRead_IsRejectedByTheSequenceToken()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // Compiled out by the DISABLE_THREADS hard gate: there is no snapshot to latch and
+                // no token to bind to. Keyed off the platform, never off another kind of the icall
+                // under test, so a regression to -1 everywhere cannot satisfy this vacuously.
+                Assert.Equal(-1, ScoutStats(CondemnedSnapshot));
+                Assert.Equal(-1, ScoutStats(CondemnedSequence));
+                return;
+            }
+
+            // Live on BOTH single-threaded legs: the protocol is a property of the getter, not of
+            // whether anything is currently condemned.
+            int sequence = ScoutStats(CondemnedSnapshot);
+            Assert.NotEqual(0, sequence);
+
+            Assert.Equal(sequence, ScoutStats(CondemnedSequence));
+            Assert.Equal(sequence, ScoutStats(CondemnedSequence));
+
+            Assert.True(TryReadCondemnedGauges(sequence, out _),
+                "an uninterrupted gauge sweep must stay inside the generation kind 17 returned.");
+
+            // A competing logical caller refreshes in the MIDDLE of the sweep. Its generation must
+            // DIFFER — not "be greater": the token wraps, so difference is the whole contract —
+            // and the torn tuple must be rejected rather than handed back.
+            int competing = 0;
+            bool accepted = TryReadCondemnedGauges(
+                sequence, out _, () => competing = ScoutStats(CondemnedSnapshot));
+            Assert.NotEqual(sequence, competing);
+            Assert.False(accepted,
+                "a competing refresh spliced into the gauge sweep must be rejected by the sequence token.");
+
+            // And the retrying reader still converges once nothing competes, so the protocol is
+            // usable and not merely strict. Again a DIFFERENCE assertion: what a reader needs is
+            // that its own token is not the competing caller's, which is what makes the tuple it
+            // returns a single generation.
+            int[] converged = CondemnedSnapshotByKind();
+            Assert.NotEqual(competing, converged[CondemnedSequence]);
+        }
+
+        /// <summary>
+        /// GENERATION-TOKEN WRAP regression (stats kinds 17/20/24) — the boundary the rest of the
+        /// suite never reaches.
+        ///
+        /// The token must satisfy exactly one property: CONSECUTIVE SNAPSHOTS HAVE DIFFERENT
+        /// TOKENS, because kind 20 is how a reader detects that its gauge tuple spans two
+        /// generations. A counter that SATURATES at int.MaxValue satisfies that property
+        /// everywhere except at the top of its range, where it freezes — and a frozen token makes
+        /// every later torn read look single-generation, i.e. the surface stops detecting tears
+        /// permanently rather than transiently. So the runtime WRAPS to 1 instead.
+        ///
+        /// Reaching that transition honestly would take 2^31 snapshots, so kind 24 is a TEST-ONLY
+        /// seam that seeds the counter to int.MaxValue - 1. From there this test drives:
+        ///   * the ordinary increment at the very top of the range (int.MaxValue - 1 -> exactly
+        ///     int.MaxValue);
+        ///   * the WRAP (int.MaxValue -> exactly 1) — a saturating implementation returns
+        ///     int.MaxValue again here and fails;
+        ///   * an interleaved read ACROSS the wrap: a competing kind 17 spliced into the middle of
+        ///     a gauge sweep started at int.MaxValue must still be REJECTED. This is the assertion
+        ///     that matters, because it is the actual harm: under saturation the competing refresh
+        ///     returns the same int.MaxValue, kind 20 still matches, and the reader is handed a
+        ///     mixed-generation tuple with no way to know.
+        ///
+        /// Leaves the counter just past the wrap (at a small positive value), which is a normal
+        /// state for every later test — they compare tokens by difference, never by ordering.
+        /// </summary>
+        [Fact]
+        public void CondemnedSnapshot_GenerationTokenWrap_StillRejectsAMixedRead()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // Compiled out by the DISABLE_THREADS hard gate — the seam included. Keyed off the
+                // platform, never off another kind of the icall under test.
+                Assert.Equal(-1, ScoutStats(CondemnedSequenceSeedSelfTest));
+                Assert.Equal(-1, ScoutStats(CondemnedSnapshot));
+                Assert.Equal(-1, ScoutStats(CondemnedSequence));
+                return;
+            }
+
+            // Live on BOTH single-threaded legs: the token is a property of the getter, not of
+            // whether anything is currently condemned.
+            int beforeSeed = ScoutStats(CondemnedSequence);
+            Assert.Equal(CondemnedSequenceSeed, ScoutStats(CondemnedSequenceSeedSelfTest));
+
+            // The seam seeds the COUNTER and must not take a snapshot of its own: the latched
+            // generation is therefore untouched. A seam that also refreshed would advance the very
+            // counter it was asked to seed, and the exact-token assertions below would be
+            // measuring the wrong thing.
+            Assert.Equal(beforeSeed, ScoutStats(CondemnedSequence));
+
+            // One ordinary increment, landing exactly on the maximum.
+            int atMax = ScoutStats(CondemnedSnapshot);
+            Assert.Equal(int.MaxValue, atMax);
+            Assert.Equal(int.MaxValue, ScoutStats(CondemnedSequence));
+
+            // An uninterrupted sweep at the boundary is still accepted: wrapping must not make the
+            // protocol reject correct reads either.
+            Assert.True(TryReadCondemnedGauges(atMax, out _),
+                "an uninterrupted gauge sweep taken at int.MaxValue must not be rejected.");
+
+            // THE WRAP, AND THE HARM IT PREVENTS. A competing logical caller refreshes in the
+            // middle of a sweep bound to int.MaxValue. Its token must be exactly 1 — the wrap —
+            // and the torn tuple must be rejected.
+            //
+            // A SATURATING implementation fails both assertions: it hands the competing caller
+            // int.MaxValue again, so `competing` is int.MaxValue (not 1) and the sweep's closing
+            // kind 20 still equals what kind 17 returned, so the mixed tuple is ACCEPTED.
+            int competing = 0;
+            bool accepted = TryReadCondemnedGauges(
+                atMax, out _, () => competing = ScoutStats(CondemnedSnapshot));
+            Assert.Equal(1, competing);
+            Assert.False(accepted,
+                "a competing refresh spliced into a sweep must be rejected ACROSS the wrap too — a " +
+                "token frozen at int.MaxValue would accept this mixed tuple forever.");
+
+            // And the token keeps moving after the wrap, so detection resumes normally rather than
+            // the counter being stuck at its wrap target.
+            int afterWrap = ScoutStats(CondemnedSnapshot);
+            Assert.Equal(2, afterWrap);
+            Assert.Equal(afterWrap, ScoutStats(CondemnedSequence));
+            Assert.True(TryReadCondemnedGauges(afterWrap, out _),
+                "an uninterrupted gauge sweep must be accepted again once the token has wrapped.");
+        }
+
+        /// <summary>
+        /// POSITIVE saturation regression (stats kind 18). Every other assertion in this suite
+        /// requires kind 18 to be 0, so a runtime that never set the flag at all would stay green;
+        /// this one requires it to be SET, on a table deliberately pushed past the walk's raw-slot
+        /// budget through kind 23's self-test cap.
+        ///
+        /// It also pins what saturation MEANS: truncated counts are LOWER BOUNDS, so they can
+        /// never exceed the same reading taken under the full budget.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleWalk_SaturationFlag_IsSetWhenTheRawBudgetIsCrossed()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            await WithHoleyHandleTableAsync((full, selfTest) =>
+            {
+                // The real 200k budget is nowhere near crossed by a healthy runtime, and the full
+                // walk really did find the rooting handle — without which the comparison below
+                // would be a statement about two empty readings.
+                Assert.Equal(0, full[CondemnedWalkSaturated]);
+                Assert.True(full[CondemnedStrongHandles] > 0,
+                    $"the unbudgeted walk must attribute the strong handle holding the condemned " +
+                    $"instance (strong={full[CondemnedStrongHandles]}).");
+
+                // THE POSITIVE BRANCH: the self-test cap IS crossed and the flag says so.
+                Assert.Equal(1, selfTest[CondemnedWalkSaturated]);
+
+                // A saturated read may only UNDERSTATE. Deliberately stated as a weak
+                // monotonicity check, and worth being explicit about why it cannot be stronger:
+                // the surviving window is the LOW slots, which belong to the runtime's own
+                // long-lived handles, while sgen places new handles from slot_hint upward — so
+                // after the inflation this test's own rooting handle is far above the cap and a
+                // truncated bucket legitimately reads 0. "0 <= 1" is all that is provable here;
+                // the load-bearing truncation assertions are kind 18 above and kinds 21/22 in
+                // CondemnedHandleWalk_RawSlotBudget_StopsShortOfAHoleyTablesHighWaterMark.
+                Assert.True(selfTest[CondemnedStrongHandles] <= full[CondemnedStrongHandles],
+                    $"a truncated walk's counts are lower bounds " +
+                    $"(selfTest={selfTest[CondemnedStrongHandles]}, full={full[CondemnedStrongHandles]}).");
+                Assert.True(selfTest[CondemnedIdentityHandles] <= full[CondemnedIdentityHandles],
+                    $"a truncated walk's identity count is a lower bound " +
+                    $"(selfTest={selfTest[CondemnedIdentityHandles]}, full={full[CondemnedIdentityHandles]}).");
+
+                // Set-wide gauges are computed outside the handle walk, so truncation must not
+                // INVENT condemned managers: saturation is about the walk, not about the set.
+                // Deliberately <= rather than equality, exactly as elsewhere in this suite: the
+                // GC-driven scout completion can retire a stray an earlier test left pending
+                // between the two snapshots, which would make an equality order-dependent.
+                Assert.True(selfTest[CondemnedManagers] > 0,
+                    "the self-test snapshot must still see the condemned context's managers.");
+                Assert.True(selfTest[CondemnedManagers] <= full[CondemnedManagers],
+                    $"a truncated handle walk must not grow the condemned manager set " +
+                    $"(full={full[CondemnedManagers]}, selfTest={selfTest[CondemnedManagers]}).");
+            });
+        }
+
+        /// <summary>
+        /// Raw-slot bound regression (stats kinds 21/22) on a HOLEY table — the shape a
+        /// classification-only budget cannot bound.
+        ///
+        /// Each sgen handle table is an SgenArrayList whose next_slot is a persistent high-water
+        /// mark: freeing a handle only NULLs its slot, and refills reuse holes, so the mark never
+        /// comes back down. A budget that merely skipped per-slot classification work would
+        /// therefore still sweep every slot of a long, mostly-empty table — once per handle type —
+        /// while every bucket reported 0. On a single browser thread that is a pause, not just
+        /// wasted work.
+        ///
+        /// So: inflate the strong-handle table's high-water mark far past the self-test cap, free
+        /// every one of those handles to leave it holey, and require the walk to stop AT the cap
+        /// rather than at the mark.
+        ///
+        /// SCOPE OF THIS PROOF, stated plainly rather than overclaimed. Kind 21 is the runtime's
+        /// own report of how many slots it loaded, and it is the only channel there is — so this
+        /// test pins the REPORTED bound, not the sweep. A probe that walked the whole table while
+        /// still reporting the cap passed this suite unchanged; the sweep itself is guaranteed by
+        /// the loop's range expression in sgen_gchandle_foreach_slot_bounded, which is a matter for
+        /// review. What this test does catch is the shape it replaced, where the budget gated only
+        /// per-slot classification and left the reported range at the table's high-water mark.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleWalk_RawSlotBudget_StopsShortOfAHoleyTablesHighWaterMark()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            await WithHoleyHandleTableAsync((full, selfTest) =>
+            {
+                // The scanned range really is long. Kind 22 sums the high-water marks of all FOUR
+                // scanned tables, so this does not attribute the length to the strong-handle table
+                // specifically — but it does not need to: HoleyTableInflation simultaneously live
+                // Normal handles occupy that many distinct indices, so that table's mark alone is
+                // >= HoleyTableInflation and the sum can only be larger. (A DELTA across the
+                // inflation would be the attributing form but is NOT sound: sgen refills holes via
+                // sgen_array_list_find_unset, so if the table already had enough holes the mark
+                // legitimately does not move at all.)
+                Assert.True(full[CondemnedSlotsEligible] >= HoleyTableInflation,
+                    $"the inflated strong-handle table must leave the scanned high-water mark at " +
+                    $"least {HoleyTableInflation} raw slots (eligible={full[CondemnedSlotsEligible]}).");
+
+                // A high-water mark never comes back down, so the second snapshot's eligible range
+                // can only be >= the first's (>= rather than == because the two icall sweeps
+                // themselves may allocate a handle the runtime places past a table's mark).
+                Assert.True(selfTest[CondemnedSlotsEligible] >= full[CondemnedSlotsEligible],
+                    $"a table's high-water mark must never shrink " +
+                    $"(full={full[CondemnedSlotsEligible]}, selfTest={selfTest[CondemnedSlotsEligible]}).");
+
+                // The unbudgeted walk covers that whole range — which is what makes the next
+                // assertion a statement about the CAP and not about an empty table.
+                Assert.Equal(full[CondemnedSlotsEligible], full[CondemnedSlotsVisited]);
+                Assert.True(full[CondemnedSlotsVisited] > CondemnedSelfTestSlotBudget,
+                    $"the eligible range must exceed the self-test cap for this to be a bound " +
+                    $"(visited={full[CondemnedSlotsVisited]}, cap={CondemnedSelfTestSlotBudget}).");
+
+                // THE PROPERTY UNDER TEST: the walk reports having stopped at the RAW slot cap,
+                // far short of the mark it was eligible to cover. See the SCOPE note above for
+                // what this does and does not establish.
+                Assert.True(selfTest[CondemnedSlotsVisited] > 0,
+                    "the budgeted walk must still have loaded slots — a walk that ran not at all " +
+                    "would satisfy the cap vacuously.");
+                Assert.True(selfTest[CondemnedSlotsVisited] <= CondemnedSelfTestSlotBudget,
+                    $"the walk must stop at its raw-slot cap, not at the table's high-water mark " +
+                    $"(visited={selfTest[CondemnedSlotsVisited]}, cap={CondemnedSelfTestSlotBudget}, " +
+                    $"eligible={selfTest[CondemnedSlotsEligible]}).");
+                Assert.True(selfTest[CondemnedSlotsVisited] < selfTest[CondemnedSlotsEligible],
+                    $"the budgeted walk must have left slots unvisited " +
+                    $"(visited={selfTest[CondemnedSlotsVisited]}, eligible={selfTest[CondemnedSlotsEligible]}).");
+            });
+        }
+
+        // Builds the shape both raw-walk regressions need — a CONDEMNED context, so the walk runs
+        // at all, plus a strong-handle table whose persistent high-water mark is far above the
+        // self-test cap while nearly every slot in it is a hole — takes one full-budget snapshot
+        // and one self-test snapshot of that state, hands both to `assert`, and then drains the
+        // context so no later test's gauges are polluted.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static async Task WithHoleyHandleTableAsync(Action<int[], int[]> assert)
+        {
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            GCHandle root = default;
+
+            bool bodySucceeded = false;
+            try
+            {
+                root = RootCollectibleInstanceAndInflateHandleTable(context);
+
+                // Both snapshots describe the SAME state: nothing between them allocates or frees
+                // a handle, so the only difference is the raw-slot cap they were taken under.
+                int[] full = CondemnedSnapshotByKind();
+                int[] selfTest = SelfTestSnapshotByKind();
+                assert(full, selfTest);
+                bodySucceeded = true;
+            }
+            finally
+            {
+                // The drain runs UNCONDITIONALLY, from the finally: a failing assertion above must
+                // not skip it. Leaving a collectible+unloading context pending would break every
+                // later test in this serialized collection that asserts an exact gauge, turning
+                // one real failure into a spray of order-dependent ones.
+                if (root.IsAllocated)
+                {
+                    root.Free();
+                }
+
+                GcQuiesce();
+                int outcome = await ForceUntilCompletedAsync(context, 10);
+                context = null;
+
+                // ...but its OUTCOME is only asserted when the body succeeded. An assertion thrown
+                // from a finally block replaces the in-flight one, which would hide the real
+                // failure behind a teardown symptom.
+                if (bodySucceeded)
+                {
+                    Assert.Equal(Completed, outcome);
+                    await CollectAndAssertDeadAsync(weakRef,
+                        "the context must be reclaimable once the rooting handle is freed.");
+                }
+            }
+        }
+
+        // Roots one instance out of the collectible context with a strong handle (so the context
+        // stays condemned and the walk has something to attribute), then inflates the strong-handle
+        // table's high-water mark and punches it full of holes.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static GCHandle RootCollectibleInstanceAndInflateHandleTable(AssemblyLoadContext context)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            object target = Activator.CreateInstance(type);
+            Assert.NotNull(target);
+
+            context.Unload();
+
+            // HoleyTableInflation simultaneously LIVE handles must occupy that many DISTINCT slots
+            // below the table's next_slot, so the mark is at least that high while they exist.
+            // Freeing them all then leaves the mark exactly where it was — sgen only NULLs the slot
+            // — producing a table that is long and nearly empty. That is precisely the shape a
+            // budget on classified hits walks end to end.
+            var filler = new GCHandle[HoleyTableInflation];
+            try
+            {
+                for (int i = 0; i < filler.Length; i++)
+                {
+                    filler[i] = GCHandle.Alloc(new object(), GCHandleType.Normal);
+                }
+            }
+            finally
+            {
+                for (int i = 0; i < filler.Length; i++)
+                {
+                    if (filler[i].IsAllocated)
+                    {
+                        filler[i].Free();
+                    }
+                }
+            }
+
+            return GCHandle.Alloc(target, GCHandleType.Normal);
+        }
+
+        // Slots of the handle array driven by CondemnedHandleClassification_ReportsHoldingHandleByType.
+        private const int HandleStrong = 0;
+        private const int HandlePinned = 1;
+        private const int HandleWeak = 2;
+        private const int HandleWeakTrack = 3;
+        private const int HandleNegativePlain = 4;
+        private const int HandleNegativeContainer = 5;
+        private const int HandleSlotCount = 6;
+
+        // Latches ONE condemned-set snapshot (kind 17) and reads every gauge out of THAT
+        // generation, indexed BY STAT KIND so the assertions read like the documented contract.
+        //
+        // The latch alone is NOT enough to make the multi-read atomic, which is why this is a
+        // token-bound read with a retry: the gauge reads carry no generation of their own, so a
+        // second LOGICAL caller taking its own kind 17 between two of them would hand this caller
+        // a tuple spanning two generations — "kind 11 from before a context was reclaimed, kind
+        // 12 from after" — the impossible combination this surface exists to rule out. No native
+        // thread race is needed. Kind 20 reports the latched token WITHOUT refreshing, so
+        // re-reading it after the sweep detects exactly that — by EQUALITY, since the token wraps
+        // and carries no ordering. See
+        // CondemnedSnapshot_MixedGenerationRead_IsRejectedByTheSequenceToken and
+        // CondemnedSnapshot_GenerationTokenWrap_StillRejectsAMixedRead.
+        private static int[] CondemnedSnapshotByKind()
+            => LatchedSnapshotByKind(CondemnedSnapshot);
+
+        // Same protocol, but the snapshot is taken under kind 23's deliberately tiny raw-slot cap
+        // so the truncation path is reachable from a test.
+        private static int[] SelfTestSnapshotByKind()
+            => LatchedSnapshotByKind(CondemnedSnapshotSelfTest);
+
+        private static int[] LatchedSnapshotByKind(int snapshotKind)
+        {
+            // Three attempts: nothing in this single-threaded suite competes for the latch, so a
+            // torn read here would already be a protocol bug — but the retry is the documented
+            // contract and this helper is the reference implementation of it.
+            for (int attempt = 0; attempt < 3; attempt++)
+            {
+                int sequence = ScoutStats(snapshotKind);
+
+                // Non-zero is the whole requirement: 0 means "no snapshot has ever been taken",
+                // and the token is a WRAPPING generation, so nothing stronger (no ordering against
+                // a previous read) may be asserted here.
+                Assert.NotEqual(0, sequence);
+
+                if (TryReadCondemnedGauges(sequence, out int[] byKind))
+                {
+                    return byKind;
+                }
+            }
+
+            throw new InvalidOperationException(
+                $"three consecutive reads of the kind {snapshotKind} snapshot were all torn by a competing refresh.");
+        }
+
+        // Reads every COUNT gauge of the currently latched snapshot and reports whether the whole
+        // sweep stayed inside generation `sequence`, per the kind 17 / gauges / kind 20 protocol.
+        // `interleave` is invoked ONCE, halfway through the sweep, and exists solely so the
+        // regression can splice a competing caller's refresh into it; production reads pass null.
+        // Halfway rather than after the first read on purpose: that leaves gauges from BOTH
+        // generations in the tuple, which is the shape the contract calls impossible.
+        private static bool TryReadCondemnedGauges(int sequence, out int[] byKind, Action interleave = null)
+        {
+            byKind = new int[CondemnedSnapshotSelfTest + 1];
+
+            int spliceAfter = interleave == null ? -1 : s_condemnedGaugeKinds.Length / 2;
+            for (int i = 0; i < s_condemnedGaugeKinds.Length; i++)
+            {
+                byKind[s_condemnedGaugeKinds[i]] = ScoutStats(s_condemnedGaugeKinds[i]);
+                if (i == spliceAfter)
+                {
+                    interleave();
+                }
+            }
+
+            byKind[CondemnedSequence] = ScoutStats(CondemnedSequence);
+            return byKind[CondemnedSequence] == sequence;
+        }
+
+        // Both dark configurations, keyed off the PLATFORM rather than off the icall under test:
+        // deriving the expectation from another kind of the same call would be self-confirming —
+        // a regression that made the whole surface report -1 would satisfy both dark legs
+        // vacuously.
+        private static void AssertClassificationDarkSurface()
+        {
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // The forced-unload machinery, and this surface with it, is compiled out by the
+                // DISABLE_THREADS hard gate: every kind must report UNAVAILABLE, never 0.
+                Assert.Equal(-1, ScoutStats(CondemnedSnapshot));
+                Assert.Equal(-1, ScoutStats(CondemnedSnapshotSelfTest));
+                Assert.Equal(-1, ScoutStats(CondemnedSequence));
+                foreach (int kind in s_condemnedGaugeKinds)
+                {
+                    Assert.Equal(-1, ScoutStats(kind));
+                }
+
+                return;
+            }
+
+            // Single-threaded with the opt-in off: the surface is LIVE — the snapshot latches
+            // and returns a generation token — but nothing is natively collectible, so the
+            // condemned set is genuinely EMPTY and every gauge honestly reads 0.
+            int latched = ScoutStats(CondemnedSnapshot);
+            Assert.NotEqual(0, latched);
+
+            // The token reports that generation and takes no new one, so reading it twice cannot
+            // move it.
+            Assert.Equal(latched, ScoutStats(CondemnedSequence));
+            Assert.Equal(latched, ScoutStats(CondemnedSequence));
+
+            foreach (int kind in s_condemnedGaugeKinds)
+            {
+                Assert.Equal(0, ScoutStats(kind));
+            }
+
+            // The self-test trigger is live here too. With an EMPTY condemned set the handle walk
+            // is skipped entirely, so it can neither visit a slot nor saturate — a tiny budget
+            // does not manufacture truncation out of nothing.
+            // A DIFFERENT generation, not a "later" one: the token wraps, so the only thing the
+            // runtime promises across two consecutive snapshots is that their tokens differ.
+            int selfTest = ScoutStats(CondemnedSnapshotSelfTest);
+            Assert.NotEqual(latched, selfTest);
+            Assert.NotEqual(0, selfTest);
+            Assert.Equal(0, ScoutStats(CondemnedWalkSaturated));
+            Assert.Equal(0, ScoutStats(CondemnedSlotsVisited));
+            Assert.Equal(0, ScoutStats(CondemnedSlotsEligible));
+        }
+
+        // Loads the collectible assembly, creates the two probe instances, unloads, and then
+        // allocates the classified handles in four tight phases — asserting EXACT bucket deltas
+        // across each, including a +1/-1 pair on the identity bucket. Everything managed stays
+        // confined to this frame so the GCHandles are the only roots the buckets can attribute,
+        // and each measurement interval contains nothing but the GCHandle.Alloc calls under test,
+        // which is what makes the deltas exact rather than merely monotone. Returns the baseline
+        // snapshot for the caller's later phases.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static int[] RootCollectibleInstancesWithClassifiedHandles(
+            AssemblyLoadContext context, GCHandle[] handles)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            Type pointerFreeType = asm.GetType(PointerFreeClassName, throwOnError: true);
+            object strongTarget = Activator.CreateInstance(type);
+
+            // PointerFreeTestClass has no reference fields, so an instance of it is PINNABLE —
+            // which is what lets kinds 12 and 14 be exercised with real handles instead of being
+            // asserted to stay at zero.
+            object pinnedTarget = Activator.CreateInstance(pointerFreeType);
+            Assert.NotNull(strongTarget);
+            Assert.NotNull(pinnedTarget);
+
+            context.Unload();
+
+            // BASELINE: the context is already condemned (collectible + unloading) and its
+            // managers are in scope, but none of this test's handles exist yet.
+            int[] before = CondemnedSnapshotByKind();
+            Assert.True(before[CondemnedManagers] > 0,
+                $"the unloading context's memory managers must enter the condemned set " +
+                $"(managers={before[CondemnedManagers]}).");
+            Assert.True(before[CondemnedLiveWitnesses] > 0,
+                $"an unloading context with live instances must still have a live LoaderAllocator " +
+                $"witness (witnesses={before[CondemnedLiveWitnesses]}).");
+            Assert.Equal(0, before[CondemnedWalkSaturated]);
+
+            // The runtime's OWN roots are already attributable — but only by IDENTITY: the
+            // managed wrapper (which PrepareForAssemblyLoadContextRelease promoted to a STRONG
+            // handle when Unload was requested) and the LoaderAllocator witness are both
+            // corelib-classed, so kinds 11-14 are blind to them by construction. Asserting this
+            // documents why the type buckets alone would under-report the real root set.
+            Assert.True(before[CondemnedIdentityHandles] >= 2,
+                $"the runtime's own wrapper and witness handles must be identity-attributed " +
+                $"(identity={before[CondemnedIdentityHandles]}, strong={before[CondemnedStrongHandles]}).");
+
+            // PHASE A — strong and weak only. The +0 on the untouched buckets is the load-bearing
+            // half: it proves the buckets are separated by handle TYPE rather than lumped.
+            handles[HandleStrong] = GCHandle.Alloc(strongTarget, GCHandleType.Normal);
+            handles[HandleWeak] = GCHandle.Alloc(pinnedTarget, GCHandleType.Weak);
+            AssertBucketDeltas(before, CondemnedSnapshotByKind(), 1, 0, 1, 0);
+
+            // PHASE B — add the pinned and weak-track handles. Both target the pointer-free
+            // instance, which the pinned handle also keeps observable for the weak buckets: the
+            // previous shape used a static for that, and a static is a second STRONG root, so it
+            // made "the strong handle alone holds the witness" unprovable.
+            handles[HandlePinned] = GCHandle.Alloc(pinnedTarget, GCHandleType.Pinned);
+            handles[HandleWeakTrack] = GCHandle.Alloc(pinnedTarget, GCHandleType.WeakTrackResurrection);
+            int[] afterB = CondemnedSnapshotByKind();
+            AssertBucketDeltas(before, afterB, 1, 1, 1, 1);
+
+            // NEGATIVE CONTROLS. (1) A handle on a plain corelib object must move nothing — the
+            // walk is not counting handles indiscriminately. (2) A handle on an object[] HOLDING
+            // the collectible instance must ALSO move nothing: the array is corelib-classed, so
+            // one-hop class attribution cannot see the condemned instance it roots. That second
+            // zero is the documented blind spot of this diagnostic, asserted rather than assumed.
+            handles[HandleNegativePlain] = GCHandle.Alloc(new object(), GCHandleType.Normal);
+            handles[HandleNegativeContainer] = GCHandle.Alloc(new object[] { strongTarget }, GCHandleType.Normal);
+            int[] afterControls = CondemnedSnapshotByKind();
+            AssertBucketDeltas(before, afterControls, 1, 1, 1, 1);
+            Assert.Equal(afterB[CondemnedManagers], afterControls[CondemnedManagers]);
+
+            // IDENTITY ATTRIBUTION COUNTS HANDLES, NOT DISTINCT OBJECTS. `context` is ALREADY in
+            // the identity set — the runtime's own strong handle targets it — so a SECOND handle
+            // onto the very same object must still move kind 19 by exactly +1, and back by exactly
+            // -1 when freed. That +1/-1 pair is what separates per-handle counting from
+            // unique-object counting: an implementation that reported the size of the identity set
+            // would satisfy "identity >= 2" above and never move here at all.
+            //
+            // Kinds 11-14 must stay FLAT across the same interval: identity attribution is checked
+            // first and is class-blind, and the wrapper's own class lives in the (non-collectible)
+            // default context anyway, so no class bucket may claim this handle.
+            var identityHandle = GCHandle.Alloc(context, GCHandleType.Normal);
+            int[] afterIdentity;
+            try
+            {
+                afterIdentity = CondemnedSnapshotByKind();
+
+                // Asserted FIRST so that a change in the identity SET (rather than in the number
+                // of handles into it) is attributed to its real cause instead of showing up as a
+                // mysterious kind 19 delta.
+                Assert.Equal(afterControls[CondemnedLiveWitnesses], afterIdentity[CondemnedLiveWitnesses]);
+                Assert.Equal(afterControls[CondemnedIdentityHandles] + 1, afterIdentity[CondemnedIdentityHandles]);
+                AssertBucketDeltas(afterControls, afterIdentity, 0, 0, 0, 0);
+            }
+            finally
+            {
+                identityHandle.Free();
+            }
+
+            int[] afterIdentityFreed = CondemnedSnapshotByKind();
+
+            // Same stability guard as the +1 direction, for the same reason: kind 19 counts
+            // handles onto ANY member of the identity set, so a shared-generic witness dying in
+            // this window would move it for a reason that has nothing to do with handle counting.
+            // Without this the -1 assertion could fail as "expected N-1, got N-2" and point at
+            // the wrong thing.
+            Assert.Equal(afterIdentity[CondemnedLiveWitnesses], afterIdentityFreed[CondemnedLiveWitnesses]);
+            Assert.Equal(afterIdentity[CondemnedManagers], afterIdentityFreed[CondemnedManagers]);
+            Assert.Equal(afterIdentity[CondemnedIdentityHandles] - 1, afterIdentityFreed[CondemnedIdentityHandles]);
+            AssertBucketDeltas(before, afterIdentityFreed, 1, 1, 1, 1);
+
+            GC.KeepAlive(strongTarget);
+            GC.KeepAlive(pinnedTarget);
+            return before;
+        }
+
+        // Exact per-bucket deltas between two snapshots of the classification surface.
+        private static void AssertBucketDeltas(
+            int[] before, int[] after, int strong, int pinned, int weak, int weakTrack)
+        {
+            Assert.Equal(before[CondemnedStrongHandles] + strong, after[CondemnedStrongHandles]);
+            Assert.Equal(before[CondemnedPinnedHandles] + pinned, after[CondemnedPinnedHandles]);
+            Assert.Equal(before[CondemnedWeakHandles] + weak, after[CondemnedWeakHandles]);
+            Assert.Equal(before[CondemnedWeakTrackHandles] + weakTrack, after[CondemnedWeakTrackHandles]);
+            Assert.Equal(0, after[CondemnedWalkSaturated]);
+        }
