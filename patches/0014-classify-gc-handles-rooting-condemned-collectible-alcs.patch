+        /// What this test establishes, and deliberately no more:
+        ///   * EXACT attribution. Each of the four handle buckets moves by exactly +1 for its
+        ///     own handle type and by exactly +0 for the others, measured across intervals whose
+        ///     only content is the GCHandle.Alloc calls themselves — so the buckets are proven
+        ///     separated by handle type, not merely non-zero.
+        ///   * NEGATIVE CONTROLS. A handle on a plain corelib object moves nothing, and — the
+        ///     documented LIMIT of this diagnostic — neither does a handle on an object[] that
+        ///     HOLDS a collectible instance: attribution is one hop, so a container root is
+        ///     invisible to kinds 11-14. That zero is asserted, not just described.
+        ///   * The STRONG handle alone holds the witness: after every other handle is freed it
+        ///     still pins the teardown at NotQuiescent, and freeing it drains the bucket and
+        ///     lets the teardown complete.
+        ///   * Kinds 12 and 14 are exercised LIVE (real Pinned / WeakTrackResurrection handles),
+        ///     not merely asserted to stay at zero.
+        ///   * Kind 19 counts HANDLES, not distinct objects. A second strong handle onto the
+        ///     already-registered managed ALC wrapper moves it by exactly +1 (and -1 on free)
+        ///     while kinds 11-14 stay flat — so an implementation that reported the SIZE of the
+        ///     identity set instead of the number of handles into it fails here.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleClassification_ReportsHoldingHandleByType()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            var handles = new GCHandle[HandleSlotCount];
+
+            try
+            {
+                int[] baseline = RootCollectibleInstancesWithClassifiedHandles(context, handles);
+
+                // The strong handle is a real root: the witness stays alive across collections
+                // and the teardown refuses.
+                GcQuiesce();
+                int[] rooted = CondemnedSnapshotByKind();
+                Assert.Equal(baseline[CondemnedStrongHandles] + 1, rooted[CondemnedStrongHandles]);
+                Assert.True(rooted[CondemnedLiveWitnesses] > 0,
+                    $"a strong GCHandle into the condemned set must keep a LoaderAllocator witness alive " +
+                    $"(managers={rooted[CondemnedManagers]}, witnesses={rooted[CondemnedLiveWitnesses]}).");
+                Assert.Equal(NotQuiescent, Force(context));
