+guint32
+sgen_gchandle_foreach_slot_bounded (GCHandleType handle_type, guint32 max_slots, guint32 *out_high_water,
+		SgenGCHandleReadOnlyCallback callback, gpointer user)
+{
+	if (out_high_water)
+		*out_high_water = 0;
+
+	HandleData *handle_data = gc_handles_for_type (handle_type);
+	if (!handle_data || !callback)
+		return 0;
+
+	SgenArrayList *array = &handle_data->entries_array;
+
+	/*
+	 * `next_slot` is the table's PERSISTENT high-water mark, not its live population:
+	 * sgen_gchandle_free merely NULLs a slot, and sgen_array_list_add refills holes via
+	 * sgen_array_list_find_unset without ever lowering the mark. A table that once grew large
+	 * and is now mostly holes therefore stays just as LONG as it was at its peak, for the
+	 * lifetime of the process. Clamping the RAW slot range here — rather than only skipping
+	 * per-slot work once a budget is spent — is what makes the walk's cost a function of the
+	 * budget instead of the historical peak.
