+
+static AlcCondemnedSnapshot alc_condemned_snapshot;
+static gint32 alc_condemned_snapshot_sequence;
+
+typedef struct {
+	GHashTable *managers;        /* set: MonoMemoryManager* */
+	GHashTable *witness_objects; /* set: MonoObject* identities */
+	gint32 managers_in_scope;
+	gint32 live_witnesses;
