+		alc_condemned_snapshot_take (ALC_CONDEMNED_HANDLE_SELFTEST_SLOT_BUDGET);
+		return snap->sequence;
+	case 24:
+		/* TEST-ONLY: move the generation counter next to its maximum so the WRAP is two calls
+		 * away instead of 2^31. Takes no snapshot and touches no snapshot field — deliberately
+		 * ahead of the fallback for that reason, since taking one here would advance the very
+		 * counter the caller is about to seed. Returns the seeded value so the test can assert
+		 * the seam applied rather than infer it. See the constant's comment. */
+		alc_condemned_snapshot_sequence = ALC_CONDEMNED_SEQUENCE_SELFTEST_SEED;
+		return alc_condemned_snapshot_sequence;
+	case 20:
