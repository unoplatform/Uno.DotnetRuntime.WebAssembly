+/*
+ * Condemned-set snapshot for the root-classification diagnostics (stats kinds 11-16).
+ *
+ * A downstream WASM host doing repeated collectible-ALC load/unload cycles observes the
+ * teardown reporting NotQuiescent forever: some root keeps the LoaderAllocator witnesses
+ * alive, and an exhaustive managed-side root trace found nothing — which leaves the roots
+ * managed reflection CANNOT enumerate (raw GCHandles, thread stacks/registers, native
+ * structures). These kinds narrow that down without a debugger: they classify every live GC
+ * handle whose target object belongs to a condemned context (collectible + unloading),
+ * bucketed by handle type, alongside the live-witness count for the same set.
+ *
+ * Reading is pure: the snapshot is built from the global ALC list plus each context's own
+ * manager arrays, and the handle walk never mutates a slot (see
+ * mono_gc_count_handles_into_managers). Gated exactly like the rest of the feature —
+ * unknown/unavailable kinds keep returning -1.
+ */
+typedef struct {
+	GPtrArray *managers;      /* MonoMemoryManager* of every condemned context */
+	gint32 condemned_alcs;    /* contexts contributing to the set */
+	gint32 live_witnesses;    /* managers whose LoaderAllocator witness is still alive */
+} AlcCondemnedSet;
+
+static void
+alc_condemned_set_collect (AlcCondemnedSet *set)
+{
+	set->managers = g_ptr_array_new ();
+	set->condemned_alcs = 0;
+	set->live_witnesses = 0;
+
+	alcs_lock ();
+	for (GSList *tmp = alcs; tmp; tmp = tmp->next) {
+		MonoAssemblyLoadContext *alc = (MonoAssemblyLoadContext *)tmp->data;
+		if (!alc || !alc->collectible || !alc->unloading)
+			continue;
+
+		set->condemned_alcs++;
+
+		MonoMemoryManager *primary_mm = alc->memory_manager;
+		if (primary_mm) {
+			g_ptr_array_add (set->managers, primary_mm);
+			if (primary_mm->loader_allocator_weak_handle &&
+					mono_gchandle_get_target_internal (primary_mm->loader_allocator_weak_handle) != NULL)
+				set->live_witnesses++;
+		}
+
+		mono_alc_memory_managers_lock (alc);
+		for (guint i = 0; i < alc->generic_memory_managers->len; i++) {
+			MonoMemoryManager *mm = (MonoMemoryManager *)g_ptr_array_index (alc->generic_memory_managers, i);
+			if (!mm || mm == primary_mm)
+				continue;
+			g_ptr_array_add (set->managers, mm);
+			if (mm->loader_allocator_weak_handle &&
+					mono_gchandle_get_target_internal (mm->loader_allocator_weak_handle) != NULL)
+				set->live_witnesses++;
+		}
+		mono_alc_memory_managers_unlock (alc);
+	}
+	alcs_unlock ();
+}
+
+static void
+alc_condemned_set_free (AlcCondemnedSet *set)
+{
+	g_ptr_array_free (set->managers, TRUE);
+	set->managers = NULL;
+}
+
+/*
+ * Handle buckets for the current condemned set, in the order
+ * { strong (Normal), pinned, weak (short), weak-track-resurrection }. Recomputed per read:
+ * these are diagnostics, invoked a handful of times per unload cycle by lifecycle tests and
+ * host telemetry, never on a hot path.
+ */
+static gboolean
+alc_condemned_handle_counts (gint32 *out_counts)
+{
+#ifdef HAVE_SGEN_GC
+	AlcCondemnedSet set;
+	alc_condemned_set_collect (&set);
+	mono_gc_count_handles_into_managers ((gpointer *)set.managers->pdata, (int)set.managers->len, out_counts);
+	alc_condemned_set_free (&set);
+	return TRUE;
+#else
+	(void)out_counts;
+	return FALSE;
+#endif
+}
