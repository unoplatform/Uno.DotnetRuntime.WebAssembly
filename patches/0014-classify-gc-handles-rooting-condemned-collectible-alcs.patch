+		alc_foreach_teardown_manager (alc, alc_condemned_set_visit, &build);
+	}
+	alcs_unlock ();
+
+	AlcCondemnedSnapshot *snap = &alc_condemned_snapshot;
+	memset (snap, 0, sizeof (*snap));
+	snap->managers_in_scope = build.managers_in_scope;
+	snap->live_witnesses = build.live_witnesses;
+
+#ifdef HAVE_SGEN_GC
+	MonoSgenCondemnedHandleScan scan;
+	memset (&scan, 0, sizeof (scan));
+	scan.condemned_managers = build.managers;
+	scan.condemned_objects = build.witness_objects;
+	scan.slot_budget = slot_budget;
+	sgen_scan_handles_into_managers (&scan);
+	for (int i = 0; i < ALC_CONDEMNED_HANDLE_BUCKETS; ++i)
+		snap->handle_counts [i] = scan.class_hits [i];
+	snap->identity_hits = scan.identity_hits;
+	snap->slots_visited = scan.slots_visited;
+	snap->slots_eligible = scan.slots_eligible;
+	snap->saturated = scan.saturated;
+	snap->handles_available = TRUE;
+#else
+	(void)slot_budget;
+#endif
+
+	g_hash_table_destroy (build.witness_objects);
+	g_hash_table_destroy (build.managers);
+
+	/* Monotonic and never 0 (0 means "never taken"); saturating rather than wrapping. */
+	if (alc_condemned_snapshot_sequence < G_MAXINT32)
+		alc_condemned_snapshot_sequence++;
+	snap->sequence = alc_condemned_snapshot_sequence;
+}
