+                handles[HandleNegativeContainer].Free();
+                handles[HandlePinned].Free();
+                handles[HandleWeak].Free();
+                handles[HandleWeakTrack].Free();
+                GcQuiesce();
+
+                int[] strongOnly = CondemnedSnapshotByKind();
+                Assert.Equal(rooted[CondemnedStrongHandles], strongOnly[CondemnedStrongHandles]);
+                Assert.Equal(rooted[CondemnedPinnedHandles] - 1, strongOnly[CondemnedPinnedHandles]);
+                Assert.Equal(rooted[CondemnedWeakHandles] - 1, strongOnly[CondemnedWeakHandles]);
+                Assert.Equal(rooted[CondemnedWeakTrackHandles] - 1, strongOnly[CondemnedWeakTrackHandles]);
+                Assert.True(strongOnly[CondemnedLiveWitnesses] > 0,
