diff --git a/src/mono/mono/metadata/sgen-mono.c b/src/mono/mono/metadata/sgen-mono.c
index e7611b1b9..e1f2cbc56 100644
--- a/src/mono/mono/metadata/sgen-mono.c
+++ b/src/mono/mono/metadata/sgen-mono.c
@@ -1883,6 +1883,86 @@ walk_references (GCObject *start, size_t size, void *data)
  * profiler event handler.
  * \returns a non-zero value if the GC doesn't support heap walking
  */
+/*
+ * GC-handle classification for the host-triggered collectible AssemblyLoadContext unload
+ * diagnostics (see the InternalGetScoutRetirementStats kinds 11-14 in
+ * assembly-load-context.c). A downstream WASM host that strands one collectible context per
+ * load/unload cycle needs to know WHICH class of root keeps a condemned context's
+ * LoaderAllocator witness alive; managed reflection cannot enumerate raw GCHandles, so the
+ * runtime reports them here, bucketed by handle type.
+ *
+ * Read-only by construction: the iteration callback always returns the slot value it was
+ * given, so no handle is ever freed, moved or re-tagged by the walk.
+ *
+ * Safety. sgen_gchandle_iterate documents that the world must be stopped; its callers are
+ * collection-time. This entry point is only reached from the DISABLE_THREADS-gated
+ * diagnostics icall on the single-threaded browser runtime, where no other thread can exist
+ * and no collection can be in progress underneath an icall — the precondition is therefore
+ * satisfied trivially rather than by taking the world down. Dereferencing a target's vtable
+ * is safe for the same reason the forced teardown is: a manager is only freed once its
+ * whole witness set is dead, so no object can outlive its own class's memory manager.
+ */
+typedef struct {
+	gpointer *managers;
+	int n_managers;
+	int bucket;
+	gint32 *counts;
+} SgenCollectibleHandleCtx;
+
+static gpointer
+count_handle_into_managers (gpointer hidden, GCHandleType handle_type, int max_generation, gpointer user)
+{
+	SgenCollectibleHandleCtx *ctx = (SgenCollectibleHandleCtx *)user;
+
+	(void)max_generation; /* liveness filtering is not wanted here: every live handle counts */
+
+	/* Skip empty slots and slots holding a metadata (null-target) pointer. */
+	if (!MONO_GC_HANDLE_VALID (hidden) || !MONO_GC_HANDLE_IS_OBJECT_POINTER (hidden))
+		return hidden;
+
+	GCObject *obj = (GCObject *)MONO_GC_REVEAL_POINTER (hidden, GC_HANDLE_TYPE_IS_WEAK (handle_type));
+	if (!obj)
+		return hidden;
+
+	MonoVTable *vtable = (MonoVTable *)SGEN_LOAD_VTABLE (obj);
+	if (!vtable || !vtable->klass)
+		return hidden;
+
+	MonoMemoryManager *mm = m_class_get_mem_manager (vtable->klass);
+	if (mm) {
+		for (int i = 0; i < ctx->n_managers; ++i) {
+			if (ctx->managers [i] == (gpointer)mm) {
+				ctx->counts [ctx->bucket]++;
+				break;
+			}
+		}
+	}
+
+	return hidden;
+}
+
+void
+mono_gc_count_handles_into_managers (gpointer *managers, int n_managers, gint32 *out_counts)
+{
+	static const GCHandleType bucket_types [4] = { HANDLE_NORMAL, HANDLE_PINNED, HANDLE_WEAK, HANDLE_WEAK_TRACK };
+
+	for (int i = 0; i < 4; ++i)
+		out_counts [i] = 0;
+
+	if (!managers || n_managers <= 0)
+		return;
+
+	SgenCollectibleHandleCtx ctx;
+	ctx.managers = managers;
+	ctx.n_managers = n_managers;
+	ctx.counts = out_counts;
+
+	for (int i = 0; i < 4; ++i) {
+		ctx.bucket = i;
+		sgen_gchandle_iterate (bucket_types [i], GENERATION_OLD, count_handle_into_managers, &ctx);
+	}
