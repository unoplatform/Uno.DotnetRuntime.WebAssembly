+/* Contexts a teardown could still be pending for: the ONE definition of "condemned", shared by
+ * the kind 8 gauge and the kinds 11-24 snapshot so the two can never drift apart. */
+static gboolean
+alc_is_condemned (MonoAssemblyLoadContext *alc)
+{
+	return alc && alc->collectible && alc->unloading;
+}
+
+/* The manager's LoaderAllocator witness object, or NULL if the witness is dead or was never
+ * materialised. A NULL weak handle means no LoaderAllocator bookkeeping ever existed for that
+ * manager (no vtable/object of it was created), which is quiescent, not live. */
+static MonoObject *
+alc_manager_witness_object (MonoMemoryManager *mm)
+{
+	if (!mm || !mm->loader_allocator_weak_handle)
+		return NULL;
+	return (MonoObject *)mono_gchandle_get_target_internal (mm->loader_allocator_weak_handle);
+}
+
+/* Return FALSE to stop the walk early. */
+typedef gboolean (*AlcManagerVisitFunc) (MonoMemoryManager *mm, gpointer user_data);
+
+/*
+ * Visits EVERY memory manager a teardown of `alc` would free: the primary manager plus each
+ * shared generic manager the context owns, skipping duplicates of the primary. THE single
+ * definition of that set — the quiescence gate (alc_is_managed_quiescent), and the condemned
+ * snapshot behind stats kinds 11-24, all consume it, so the gate can never disagree with the
+ * gauge that claims to report "the exact quantity the gate refuses on".
+ *
+ * NULL-safe on both arrays: mono_alc_cleanup frees and NULLs generic_memory_managers (and the
+ * primary) during teardown, so a read-only gauge racing a tombstoned context must not
+ * dereference them. Tombstoned contexts are IN SCOPE for the walk and simply contribute
+ * nothing once their managers are gone.
+ */
+static gboolean
+alc_foreach_teardown_manager (MonoAssemblyLoadContext *alc, AlcManagerVisitFunc visit, gpointer user_data)
+{
+	MonoMemoryManager *primary_mm = alc->memory_manager;
+	if (primary_mm && !visit (primary_mm, user_data))
+		return FALSE;
+
+	gboolean completed = TRUE;
+	mono_alc_memory_managers_lock (alc);
+	if (alc->generic_memory_managers) {
+		for (guint i = 0; i < alc->generic_memory_managers->len; i++) {
+			MonoMemoryManager *mm = (MonoMemoryManager *)g_ptr_array_index (alc->generic_memory_managers, i);
+			if (!mm || mm == primary_mm)
+				continue;
+			if (!visit (mm, user_data)) {
+				completed = FALSE;
+				break;
+			}
+		}
+	}
+	mono_alc_memory_managers_unlock (alc);
+	return completed;
+}
+
+static gboolean
+alc_visit_stop_on_live_witness (MonoMemoryManager *mm, gpointer user_data)
+{
+	if (!alc_manager_witness_object (mm))
+		return TRUE;
+	*(gboolean *)user_data = TRUE;
+	return FALSE;
+}
+
+/*
+ * Quiescence gate — ALL-OR-NOTHING over the exact set of managers a teardown would free.
+ * alc->unloading only means the managed Unload() was requested — it is NOT proof that the
+ * collectible LoaderAllocators have been collected. Stack frames, shared-generic type
+ * arguments, delegates and runtime handles can still root them (dotnet/runtime#40394,
+ * #34072). mono_mem_manager_start_unload already dropped the strong handles, so each
+ * LoaderAllocator is now held only by managed references; while a manager's weak-handle
+ * target is non-NULL, managed roots remain and freeing would reclaim live memory. This is
+ * exactly the criterion the LoaderAllocatorScout uses.
+ *
+ * Every shared/generic memory manager has its OWN LoaderAllocator witness: a live
+ * cross-context constructed generic (e.g. an instance whose vtable lives in a shared
+ * {default, this} manager) keeps that shared witness alive even after the primary witness
+ * has cleared. mono_alc_cleanup deletes the primary manager AND every shared generic
+ * manager on alc->generic_memory_managers, so each of those witnesses must be dead before
+ * anything is freed — hence the shared walk above rather than a hand-copied loop. If ANY
+ * witness is live, nothing may be freed.
+ *
+ * Shared by the two teardown initiators: the host-triggered InternalForceNativeUnload
+ * (which reports NotQuiescent so the host can retry) and the GC-driven scout completion in
+ * LoaderAllocatorScout_Destroy (which simply waits for a later finalization round).
