+
+/* Latched result of one condemned-set snapshot; see the ATOMICITY note above. Scalars only:
+ * manager and object POINTERS must never outlive the read that collected them, because a
+ * moving collector may relocate an object once the icall returns. */
+typedef struct {
+	/* Non-zero WRAPPING generation token, not a monotonic clock: consecutive snapshots differ,
+	 * but the token is not ordered (see the ATOMICITY note). 0 = no snapshot has ever been
+	 * taken, which is why the live range starts at 1. Compare with != , never with <. */
+	gint32 sequence;
+	gint32 managers_in_scope;
+	gint32 live_witnesses;
+	gint32 handle_counts [ALC_CONDEMNED_HANDLE_BUCKETS];
+	gint32 identity_hits;
+	gint32 slots_visited;     /* raw handle slots the walk loaded (kind 21) */
+	gint32 slots_eligible;    /* raw slots it was eligible to load (kind 22); visited <= this */
+	gboolean handles_available; /* FALSE on a non-sgen build: kinds 11-14/18/19/21/22 report -1 */
+	gboolean saturated;
