+        /// <summary>
+        /// Root-classification regression (stats kinds 11-19). A downstream WASM host whose
+        /// teardown reports NotQuiescent forever needs to know WHICH class of root holds the
+        /// condemned context's LoaderAllocator witness — managed reflection cannot enumerate raw
+        /// GCHandles, so the runtime classifies them.
+        ///
+        /// What this test establishes, and deliberately no more:
+        ///   * EXACT attribution. Each of the four handle buckets moves by exactly +1 for its
+        ///     own handle type and by exactly +0 for the others, measured across intervals whose
+        ///     only content is the GCHandle.Alloc calls themselves — so the buckets are proven
+        ///     separated by handle type, not merely non-zero.
+        ///   * NEGATIVE CONTROLS. A handle on a plain corelib object moves nothing, and — the
+        ///     documented LIMIT of this diagnostic — neither does a handle on an object[] that
+        ///     HOLDS a collectible instance: attribution is one hop, so a container root is
+        ///     invisible to kinds 11-14. That zero is asserted, not just described.
+        ///   * The STRONG handle alone holds the witness: after every other handle is freed it
+        ///     still pins the teardown at NotQuiescent, and freeing it drains the bucket and
+        ///     lets the teardown complete.
+        ///   * Kinds 12 and 14 are exercised LIVE (real Pinned / WeakTrackResurrection handles),
+        ///     not merely asserted to stay at zero.
+        /// </summary>
+        [Fact]
+        public async Task CondemnedHandleClassification_ReportsHoldingHandleByType()
+        {
+            if (BridgeMissing())
+            {
+                return;
+            }
+
+            if (!ProtocolActive)
+            {
+                AssertClassificationDarkSurface();
+                return;
+            }
+
+            var context = new ResourceAssemblyLoadContext(true) { LoadBy = LoadBy.Stream };
+            var weakRef = new WeakReference(context);
+            var handles = new GCHandle[HandleSlotCount];
+
+            try
+            {
+                int[] baseline = RootCollectibleInstancesWithClassifiedHandles(context, handles);
+
+                // The strong handle is a real root: the witness stays alive across collections
+                // and the teardown refuses.
+                GcQuiesce();
+                int[] rooted = CondemnedSnapshotByKind();
+                Assert.Equal(baseline[CondemnedStrongHandles] + 1, rooted[CondemnedStrongHandles]);
+                Assert.True(rooted[CondemnedLiveWitnesses] > 0,
+                    $"a strong GCHandle into the condemned set must keep a LoaderAllocator witness alive " +
+                    $"(managers={rooted[CondemnedManagers]}, witnesses={rooted[CondemnedLiveWitnesses]}).");
+                Assert.Equal(NotQuiescent, Force(context));
+
+                // Drop the negative controls and every NON-rooting handle. Only the strong
+                // handle is left — no static keeps anything else alive — so this is where "the
+                // strong handle ALONE holds the witness" is actually established.
+                handles[HandleNegativePlain].Free();
+                handles[HandleNegativeContainer].Free();
+                handles[HandlePinned].Free();
+                handles[HandleWeak].Free();
+                handles[HandleWeakTrack].Free();
+                GcQuiesce();
+
+                int[] strongOnly = CondemnedSnapshotByKind();
+                Assert.Equal(rooted[CondemnedStrongHandles], strongOnly[CondemnedStrongHandles]);
+                Assert.Equal(rooted[CondemnedPinnedHandles] - 1, strongOnly[CondemnedPinnedHandles]);
+                Assert.Equal(rooted[CondemnedWeakHandles] - 1, strongOnly[CondemnedWeakHandles]);
+                Assert.Equal(rooted[CondemnedWeakTrackHandles] - 1, strongOnly[CondemnedWeakTrackHandles]);
+                Assert.True(strongOnly[CondemnedLiveWitnesses] > 0,
+                    "the strong handle alone must still hold a witness after every other handle is freed.");
+                Assert.Equal(NotQuiescent, Force(context));
+
+                // Release the last root: the bucket drains by exactly one and the teardown
+                // completes — the classification tracked the ACTUAL holder, not a static shape.
+                handles[HandleStrong].Free();
+                GcQuiesce();
+                Assert.Equal(strongOnly[CondemnedStrongHandles] - 1,
+                    CondemnedSnapshotByKind()[CondemnedStrongHandles]);
+
+                Assert.Equal(Completed, await ForceUntilCompletedAsync(context, 10));
+
+                // The context has left the condemned set, so the set-wide gauges must not have
+                // GROWN. Deliberately not an exact equality: the GC-driven scout completion can
+                // retire a stray an earlier test left pending, which would push these BELOW the
+                // baseline and make an equality order-dependent.
+                int[] drained = CondemnedSnapshotByKind();
+                Assert.True(drained[CondemnedManagers] <= baseline[CondemnedManagers],
+                    $"the condemned manager set must not grow after a completed teardown " +
+                    $"(baseline={baseline[CondemnedManagers]}, after={drained[CondemnedManagers]}).");
+                Assert.True(drained[CondemnedLiveWitnesses] <= baseline[CondemnedLiveWitnesses],
+                    $"live witnesses must not grow after a completed teardown " +
+                    $"(baseline={baseline[CondemnedLiveWitnesses]}, after={drained[CondemnedLiveWitnesses]}).");
+                Assert.Equal(0, drained[CondemnedWalkSaturated]);
+
+                context = null;
+                await CollectAndAssertDeadAsync(weakRef,
+                    "the context must be reclaimable once the classified handles are freed.");
+            }
+            finally
+            {
+                // Any handle still allocated here would root a collectible context for the rest
+                // of the run and corrupt every later test's gauges, so release them on EVERY
+                // exit path, not just the successful one.
+                for (int i = 0; i < handles.Length; i++)
+                {
+                    if (handles[i].IsAllocated)
+                    {
+                        handles[i].Free();
+                    }
+                }
+            }
+        }
+
+        // Slots of the handle array driven by CondemnedHandleClassification_ReportsHoldingHandleByType.
+        private const int HandleStrong = 0;
+        private const int HandlePinned = 1;
+        private const int HandleWeak = 2;
+        private const int HandleWeakTrack = 3;
+        private const int HandleNegativePlain = 4;
+        private const int HandleNegativeContainer = 5;
+        private const int HandleSlotCount = 6;
+
+        // Latches ONE condemned-set snapshot (kind 17) and reads every gauge out of it, indexed
+        // BY STAT KIND so the assertions read like the documented contract. Reading the gauges
+        // individually without the snapshot would make them mutually inconsistent: a context
+        // reclaimed between two reads yields "all buckets zero while witnesses are live", which
+        // is exactly the false signal this surface exists to rule out.
+        private static int[] CondemnedSnapshotByKind()
+        {
+            Assert.True(ScoutStats(CondemnedSnapshot) > 0,
+                "the condemned-set snapshot must latch and return a monotonic sequence number.");
+
+            int[] byKind = new int[CondemnedIdentityHandles + 1];
+            foreach (int kind in s_condemnedGaugeKinds)
+            {
+                byKind[kind] = ScoutStats(kind);
+            }
+
+            return byKind;
+        }
+
+        // Both dark configurations, keyed off the PLATFORM rather than off the icall under test:
+        // deriving the expectation from another kind of the same call would be self-confirming —
+        // a regression that made the whole surface report -1 would satisfy both dark legs
+        // vacuously.
+        private static void AssertClassificationDarkSurface()
+        {
+            if (PlatformDetection.IsThreadingSupported)
+            {
+                // The forced-unload machinery, and this surface with it, is compiled out by the
+                // DISABLE_THREADS hard gate: every kind must report UNAVAILABLE, never 0.
+                Assert.Equal(-1, ScoutStats(CondemnedSnapshot));
+                foreach (int kind in s_condemnedGaugeKinds)
+                {
+                    Assert.Equal(-1, ScoutStats(kind));
+                }
+
+                return;
+            }
+
+            // Single-threaded with the opt-in off: the surface is LIVE — the snapshot latches
+            // and returns a sequence number — but nothing is natively collectible, so the
+            // condemned set is genuinely EMPTY and every gauge honestly reads 0.
+            Assert.True(ScoutStats(CondemnedSnapshot) > 0,
+                "the single-threaded build must latch a snapshot even with the opt-in off.");
+            foreach (int kind in s_condemnedGaugeKinds)
+            {
+                Assert.Equal(0, ScoutStats(kind));
+            }
+        }
+
+        // Loads the collectible assembly, creates the two probe instances, unloads, and then
+        // allocates the classified handles in three tight phases — asserting EXACT bucket deltas
+        // across each. Everything managed stays confined to this frame so the GCHandles are the
+        // only roots the buckets can attribute, and each measurement interval contains nothing
+        // but the GCHandle.Alloc calls under test, which is what makes the deltas exact rather
+        // than merely monotone. Returns the baseline snapshot for the caller's later phases.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static int[] RootCollectibleInstancesWithClassifiedHandles(
+            AssemblyLoadContext context, GCHandle[] handles)
+        {
+            Assembly asm = context.LoadFromAssemblyName(new AssemblyName(TestAssembly));
+            Type type = asm.GetType(TestClassName, throwOnError: true);
+            Type pointerFreeType = asm.GetType(PointerFreeClassName, throwOnError: true);
+            object strongTarget = Activator.CreateInstance(type);
+
+            // PointerFreeTestClass has no reference fields, so an instance of it is PINNABLE —
+            // which is what lets kinds 12 and 14 be exercised with real handles instead of being
+            // asserted to stay at zero.
+            object pinnedTarget = Activator.CreateInstance(pointerFreeType);
+            Assert.NotNull(strongTarget);
+            Assert.NotNull(pinnedTarget);
+
+            context.Unload();
+
+            // BASELINE: the context is already condemned (collectible + unloading) and its
+            // managers are in scope, but none of this test's handles exist yet.
+            int[] before = CondemnedSnapshotByKind();
+            Assert.True(before[CondemnedManagers] > 0,
+                $"the unloading context's memory managers must enter the condemned set " +
+                $"(managers={before[CondemnedManagers]}).");
+            Assert.True(before[CondemnedLiveWitnesses] > 0,
+                $"an unloading context with live instances must still have a live LoaderAllocator " +
+                $"witness (witnesses={before[CondemnedLiveWitnesses]}).");
+            Assert.Equal(0, before[CondemnedWalkSaturated]);
+
+            // The runtime's OWN roots are already attributable — but only by IDENTITY: the
+            // managed wrapper (which PrepareForAssemblyLoadContextRelease promoted to a STRONG
+            // handle when Unload was requested) and the LoaderAllocator witness are both
+            // corelib-classed, so kinds 11-14 are blind to them by construction. Asserting this
+            // documents why the type buckets alone would under-report the real root set.
+            Assert.True(before[CondemnedIdentityHandles] >= 2,
+                $"the runtime's own wrapper and witness handles must be identity-attributed " +
+                $"(identity={before[CondemnedIdentityHandles]}, strong={before[CondemnedStrongHandles]}).");
+
+            // PHASE A — strong and weak only. The +0 on the untouched buckets is the load-bearing
+            // half: it proves the buckets are separated by handle TYPE rather than lumped.
+            handles[HandleStrong] = GCHandle.Alloc(strongTarget, GCHandleType.Normal);
+            handles[HandleWeak] = GCHandle.Alloc(pinnedTarget, GCHandleType.Weak);
+            AssertBucketDeltas(before, CondemnedSnapshotByKind(), 1, 0, 1, 0);
+
+            // PHASE B — add the pinned and weak-track handles. Both target the pointer-free
+            // instance, which the pinned handle also keeps observable for the weak buckets: the
+            // previous shape used a static for that, and a static is a second STRONG root, so it
+            // made "the strong handle alone holds the witness" unprovable.
+            handles[HandlePinned] = GCHandle.Alloc(pinnedTarget, GCHandleType.Pinned);
+            handles[HandleWeakTrack] = GCHandle.Alloc(pinnedTarget, GCHandleType.WeakTrackResurrection);
+            int[] afterB = CondemnedSnapshotByKind();
+            AssertBucketDeltas(before, afterB, 1, 1, 1, 1);
+
+            // NEGATIVE CONTROLS. (1) A handle on a plain corelib object must move nothing — the
+            // walk is not counting handles indiscriminately. (2) A handle on an object[] HOLDING
+            // the collectible instance must ALSO move nothing: the array is corelib-classed, so
+            // one-hop class attribution cannot see the condemned instance it roots. That second
+            // zero is the documented blind spot of this diagnostic, asserted rather than assumed.
+            handles[HandleNegativePlain] = GCHandle.Alloc(new object(), GCHandleType.Normal);
+            handles[HandleNegativeContainer] = GCHandle.Alloc(new object[] { strongTarget }, GCHandleType.Normal);
+            int[] afterControls = CondemnedSnapshotByKind();
+            AssertBucketDeltas(before, afterControls, 1, 1, 1, 1);
+            Assert.Equal(afterB[CondemnedManagers], afterControls[CondemnedManagers]);
+
+            GC.KeepAlive(strongTarget);
+            GC.KeepAlive(pinnedTarget);
+            return before;
+        }
+
+        // Exact per-bucket deltas between two snapshots of the classification surface.
+        private static void AssertBucketDeltas(
+            int[] before, int[] after, int strong, int pinned, int weak, int weakTrack)
+        {
+            Assert.Equal(before[CondemnedStrongHandles] + strong, after[CondemnedStrongHandles]);
+            Assert.Equal(before[CondemnedPinnedHandles] + pinned, after[CondemnedPinnedHandles]);
+            Assert.Equal(before[CondemnedWeakHandles] + weak, after[CondemnedWeakHandles]);
+            Assert.Equal(before[CondemnedWeakTrackHandles] + weakTrack, after[CondemnedWeakTrackHandles]);
+            Assert.Equal(0, after[CondemnedWalkSaturated]);
+        }
+
         /// <summary>
         /// The no-retry residue regression: a host that never calls ForceNativeUnload at all —
         /// N load/unload/drop cycles — must leave NO native residue. An orphaned struct is
diff --git a/src/mono/System.Private.CoreLib/src/System/Runtime/Loader/AssemblyLoadContext.Mono.cs b/src/mono/System.Private.CoreLib/src/System/Runtime/Loader/AssemblyLoadContext.Mono.cs
index ca1b6ff47..bc534ff04 100644
--- a/src/mono/System.Private.CoreLib/src/System/Runtime/Loader/AssemblyLoadContext.Mono.cs
+++ b/src/mono/System.Private.CoreLib/src/System/Runtime/Loader/AssemblyLoadContext.Mono.cs
@@ -97,6 +97,37 @@ private static void KeepLoaderAllocator()
         // Kind 10 counts scout-completion DEFERRALS (monotonic): the scout finalizer ran,
         // completed nothing, and re-registered. Distinguishes "ran and refused" from "never
         // ran" — a never-dying witness climbs this while kind 7 stays flat.
+        //
+        // Kinds 11-19 are root-classification GAUGES for the condemned set (collectible +
+        // unloading contexts). They are FIELDS OF ONE SNAPSHOT:
+        //   17 — take a fresh snapshot; returns its monotonic sequence number. Read this FIRST.
+        //   11 — strong (Normal) GC handles whose TARGET's class belongs to the set  [ROOTING]
+        //   12 — pinned handles, same attribution                                   [ROOTING]
+        //   13 — weak (short) handles, same attribution                       [INFORMATIONAL]
+        //   14 — weak-track-resurrection handles, same attribution            [INFORMATIONAL]
+        //   15 — condemned memory managers in scope (the denominator; >= kind 8, which counts
+        //        contexts rather than managers)
+        //   16 — condemned managers whose LoaderAllocator witness is still alive
+        //   18 — 1 if the handle walk hit its slot budget, so 11-14/19 are LOWER BOUNDS
+        //   19 — handles of ANY type whose target IS a condemned context's own managed wrapper
+        //        or LoaderAllocator witness (corelib-classed, hence invisible to 11-14; the
+        //        runtime installs one such strong handle per in-flight unload itself)
+        //
+        // CONTRACT.
+        //   * -1 means UNAVAILABLE, never "zero": the whole surface is -1 on a threads-enabled
+        //     build (compiled out by the DISABLE_THREADS hard gate), and kinds 11-14/18/19 are
+        //     additionally -1 on a non-sgen collector. 0 means the surface is LIVE and the
+        //     condemned set is genuinely empty.
+        //   * Counts are INSTANTANEOUS and PER HANDLE, not per object: two handles onto the
+        //     same instance count twice.
