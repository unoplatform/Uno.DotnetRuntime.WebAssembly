+#define ALC_CONDEMNED_HANDLE_SELFTEST_SLOT_BUDGET 128
+
+/*
+ * TEST-ONLY SEED behind kind 24, for the same reason kind 23 exists: a behaviour that is only
+ * reachable after 2^31 snapshots is a behaviour no regression can pin, and an unpinned branch
