+	ALC_SNAPSHOT_MANAGERS_IN_SCOPE = 0,  /* condemned memory managers in scope (denominator) */
+	ALC_SNAPSHOT_LIVE_WITNESSES = 1,     /* of those, whose LoaderAllocator witness is alive */
+	ALC_SNAPSHOT_STRONG_HANDLES = 2,     /* strong (Normal) handles, class-attributed [ROOTING] */
+	ALC_SNAPSHOT_PINNED_HANDLES = 3,     /* pinned handles, class-attributed        [ROOTING] */
+	ALC_SNAPSHOT_WEAK_HANDLES = 4,       /* weak (short) handles              [INFORMATIONAL] */
+	ALC_SNAPSHOT_WEAK_TRACK_HANDLES = 5, /* weak-track-resurrection handles   [INFORMATIONAL] */
+	ALC_SNAPSHOT_IDENTITY_HANDLES = 6,   /* identity-attributed handles; counts HANDLES, not
