+#ifdef DISABLE_THREADS
+/*
+ * Read-only, raw-slot-bounded walk over one handle table. Contract, and why it exists next to
+ * sgen_gchandle_iterate rather than reusing it, in the declaration comment in sgen-gc.h.
+ */
+guint32
+sgen_gchandle_foreach_slot_bounded (GCHandleType handle_type, guint32 max_slots, guint32 *out_high_water,
+		SgenGCHandleReadOnlyCallback callback, gpointer user)
+{
+	if (out_high_water)
+		*out_high_water = 0;
+
+	HandleData *handle_data = gc_handles_for_type (handle_type);
+	if (!handle_data || !callback)
+		return 0;
+
+	SgenArrayList *array = &handle_data->entries_array;
+
+	/*
+	 * `next_slot` is the table's PERSISTENT high-water mark, not its live population:
+	 * sgen_gchandle_free merely NULLs a slot, and sgen_array_list_add refills holes via
+	 * sgen_array_list_find_unset without ever lowering the mark. A table that once grew large
+	 * and is now mostly holes therefore stays just as LONG as it was at its peak, for the
+	 * lifetime of the process. Clamping the RAW slot range here -- rather than only skipping
+	 * per-slot work once a budget is spent -- is what makes the walk's cost a function of the
+	 * budget instead of the historical peak.
+	 *
+	 * The mark is reported UNCLAMPED and the loop bound is clamped separately. Should
+	 * next_slot ever exceed capacity (it cannot today -- see sgen_array_list_add /
+	 * sgen_array_list_alloc_block), the skipped tail then shows up as visited < high_water,
+	 * i.e. as saturation, rather than as a silent omission the caller cannot see.
+	 */
+	guint32 high_water = array->next_slot;
+	if (out_high_water)
+		*out_high_water = high_water;
+
+	guint32 end = high_water;
+	guint32 capacity = array->capacity;
+	if (end > capacity)
+		end = capacity;
+	if (end > max_slots)
+		end = max_slots;
+
+	/*
+	 * COUNTED IN THE LOOP, deliberately, rather than returned as the precomputed `end`, so the
+	 * figure the caller publishes cannot silently disagree with the loop that produced it.
+	 *
+	 * Be clear about what that does NOT buy, because it is tempting to overclaim: this counter is
+	 * the ONLY channel through which the bound is observable from managed code, so no regression
+	 * test can tell a correctly bounded sweep from one that walks further and reports the bound
+	 * anyway. (Verified, not assumed: a probe that did exactly that passed the whole suite.) What
+	 * actually enforces the bound is the range of the loop below -- `end`, a single reviewable
+	 * expression -- and the fact that the same loop both walks and counts. The regression pins the
+	 * REPORTED bound, which is what catches the shape this replaced, where the budget did not
+	 * clamp the range at all.
+	 */
+	guint32 visited = 0;
+	volatile gpointer *slot;
+	guint32 index;
+	SGEN_ARRAY_LIST_FOREACH_SLOT_RANGE (array, 0, end, slot, index) {
+		gpointer hidden = *slot;
+		visited++;
+		if (MONO_GC_HANDLE_OCCUPIED (hidden))
+			callback (hidden, handle_type, user);
+	} SGEN_ARRAY_LIST_END_FOREACH_SLOT_RANGE;
+
+	return visited;
+}
+#endif /* DISABLE_THREADS */
