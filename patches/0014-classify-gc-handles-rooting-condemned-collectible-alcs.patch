+	guint32 capacity = array->capacity;
+	guint32 high_water = array->next_slot;
+	if (high_water > capacity)
+		high_water = capacity;
+	if (out_high_water)
+		*out_high_water = high_water;
+
+	guint32 end = high_water < max_slots ? high_water : max_slots;
