+	ALC_SNAPSHOT_SATURATED = 9,          /* 1 if the walk hit its raw-slot budget, so every
+	                                      * handle count above is a LOWER BOUND */
+	ALC_SNAPSHOT_FIELD_COUNT = 10        /* APPEND above this line; never renumber */
+};
