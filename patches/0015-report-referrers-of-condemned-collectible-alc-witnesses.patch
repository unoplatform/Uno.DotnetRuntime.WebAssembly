+	 * sgen_client_restart_world: that hook runs after sgen_restart_world has cleared the flag --
+	 * and, worse, runs on stop-the-worlds that never collected at all -- so a move back aborts on
+	 * the first armed scan instead of quietly reporting edges off an unswept heap. An earlier
+	 * revision DID assert this from that hook and had to remove it; the fix was the call site, not
+	 * the assertion.
+	 *
+	 * FINISHED -- not assertable, and recorded so it does not get re-added. sgen clears
+	 * sgen_current_collection_generation at the end of the minor/major collection function, which
+	 * runs before the hook, so it reads -1 here exactly as it does outside a collection. What makes
+	 * the property hold is the CALL SITE: sgen_client_collection_end is reached only from the
+	 * collection path, which is the entire reason that hook exists instead of reusing
+	 * sgen_client_restart_world (see its comment in sgen/sgen-client.h).
+	 *
+	 * mono_gc_walk_heap has the identical contract and asserts nothing about the world either; it
+	 * states the requirement and relies on its callers.
+	 */
+	g_assert (sgen_is_world_stopped ());
+	g_assert (!sgen_referrer_scan_in_progress);
+
+	/* No unbounded mode, for the same reason the handle scan has none: a diagnostic that runs
+	 * inside a GC pause on the single browser thread must carry a bound by construction, so a
+	 * non-positive budget is a caller bug rather than a mode. */
+	g_assert (scan->object_budget > 0);
+	g_assert (scan->reference_slot_budget > 0);
+
+	sgen_referrer_scan_in_progress = TRUE;
+	sgen_referrer_scan_current = scan;
+	sgen_referrer_scan_described = g_hash_table_new (g_direct_hash, g_direct_equal);
+	sgen_referrer_scan_witnesses_admitted = 0;
+
+	/*
+	 * FIRST PASS: dependent edges, which the heap walk below CANNOT see.
+	 *
+	 * sgen zeroes the GC bitmap for System.Runtime.Ephemeron (object.c, "An Ephemeron cannot be
+	 * marked by sgen"), so an ephemeron array's descriptor reports no references and every
+	 * descriptor-driven walk -- including the one below -- misses the key->value edge entirely.
+	 * The edge is nonetheless a real root: sgen_client_mark_ephemerons marks the value whenever
+	 * the key is alive, which is exactly how a ConditionalWeakTable or DependentHandle keeps its
+	 * value reachable. Without this pass a witness held only as a dependent value would produce
+	 * an UNSATURATED EMPTY report, contradicting the one thing an empty report is supposed to
+	 * mean.
+	 *
+	 * NO LIVENESS TEST, deliberately, and it would be WRONG to add one here.
+	 * sgen_client_clear_unreachable_ephemerons already ran inside the collection that is
+	 * finishing: it unlinked and freed every node whose array was dead, and tombstoned every
+	 * entry whose key was dead (clearing its value). So this list is ALREADY pruned to exactly
+	 * the live arrays and live-keyed entries, and skipping NULL/tombstone keys is the entire
+	 * test required. An earlier revision called sgen_is_object_alive_for_current_gen here to
+	 * mirror the collector, which silently dropped live PROMOTED entries: the major pass below
+	 * passes ITERATE_OBJECTS_SWEEP_ALL, marksweep's sweep_block clears block->mark_words, and
+	 * with sgen_current_collection_generation already -1 that predicate falls through to
+	 * sgen_major_is_object_alive and reads the cleared bit.
+	 *
+	 * RUNS FIRST, for two reasons. It shares the slot budget, and running it after the heap walk
+	 * meant a saturating walk could starve it completely -- silently reinstating the blind spot
+	 * this pass exists to close, in exactly the small-budget/large-heap case where it matters
+	 * most. It is also the cheapest pass and the one whose findings are most actionable.
+	 *
+	 * The referrer recorded is the KEY: "alive exactly as long as this key is" is the actionable
+	 * identity, and the ephemeron array that happens to hold the pair is not.
+	 */
+	for (EphemeronLinkNode *current = ephemeron_list; current; current = current->next) {
+		MonoArray *array = current->array;
+		if (!array)
+			continue;
+
+		Ephemeron *cur = mono_array_addr_internal (array, Ephemeron, 0);
+		Ephemeron *array_end = cur + mono_array_length_internal (array);
+		GCObject *tombstone = SGEN_LOAD_VTABLE ((GCObject*)array)->domain->ephemeron_tombstone;
+
+		for (; cur < array_end; ++cur) {
+			GCObject *key = cur->key;
+			if (!key || key == tombstone)
+				continue;
+
+			GCObject *value = cur->value;
+			if (!value)
+				continue;
+
+			/* Charged like any other reference slot, so one enormous CWT cannot outspend the
+			 * budget. */
+			if (!sgen_referrer_charge_slot ())
+				break;
+
+			scan->ephemeron_entries_visited++;
+			if (g_hash_table_contains (scan->condemned_objects, value))
+				sgen_referrer_record (key, value, (guint32)(cur - mono_array_addr_internal (array, Ephemeron, 0)), TRUE);
+		}
+	}
+
+	/*
+	 * SECOND PASS: the same three regions mono_gc_walk_heap covers, in the same order, because
+	 * between them they are the heap: the nursery, the major heap, and the large-object space.
+	 * Missing one would silently narrow the search and make an empty result untrustworthy in a
+	 * way `saturated` does not report.
+	 */
+	sgen_clear_nursery_fragments ();
+	sgen_scan_area_with_callback (sgen_nursery_section->data, sgen_nursery_section->end_data,
+			sgen_referrer_visit_object, scan, FALSE, TRUE);
+	sgen_major_collector.iterate_objects (ITERATE_OBJECTS_SWEEP_ALL, sgen_referrer_visit_object, scan);
+	sgen_los_iterate_objects (sgen_referrer_visit_object, scan);
+
+
+	g_hash_table_destroy (sgen_referrer_scan_described);
+	sgen_referrer_scan_described = NULL;
+	sgen_referrer_scan_witnesses_admitted = 0;
+	sgen_referrer_scan_current = NULL;
+	sgen_referrer_scan_in_progress = FALSE;
+}
 #endif /* DISABLE_THREADS */
 
+/*
+ * Collection-completion hook: sgen calls this from sgen_perform_collection_inner immediately
+ * before sgen_restart_world, so the collection has FINISHED and the mutators are still suspended.
+ * Nothing else is dispatched from here; see sgen/sgen-client.h for the contract.
+ *
+ * It exists because sgen_client_restart_world -- where an earlier revision of the diagnostic below
+ * was called from -- is NOT a collection-only hook. The world is also stopped and restarted with
+ * no collection at all by sgen_get_total_allocated_bytes (TRUE), which is the implementation of
+ * the ordinary public GC.GetTotalAllocatedBytes (precise: true), and by sgen_check_whole_heap_stw
+ * () in verification mode; sgen-stw.c's own "this is the wrong spot at we can STW for non
+ * collection reasons" comment says as much. The arguments cannot discriminate either, since both
+ * of those pass generation 0 exactly as a nursery collection does.
+ *
+ * From the restart hook, a caller that merely read precise allocation bytes after a refusal would
+ * CONSUME the one-shot referrer-scan request against an unswept heap on which
+ * sgen_client_clear_unreachable_ephemerons had not run: the ephemeron pass could then report a
+ * dead-key or dead-array edge, and the descriptor pass a reference held only by unreachable
+ * garbage. Both are false positives, and both contradict the pruned-list invariant that pass
+ * rests on. Do not move the call back;
+ * ForcedUnload_ReferrerScan_NonCollectionStopTheWorldDoesNotServeTheRequest fails if anyone does,
+ * and sgen_scan_referrers_of_condemned's sgen_is_world_stopped () assertion aborts on the first
+ * armed scan.
+ *
+ * The generation/serial_collection arguments mirror the stop/restart pair this sits beside and
+ * describe the collection that just ended; nothing dispatched from here needs them yet.
+ */
+void
+sgen_client_collection_end (int generation, gboolean serial_collection)
+{
+#ifdef DISABLE_THREADS
+	mono_alc_referrer_scan_at_gc_pause ();
+#endif
+}
+
 /*
  * Threads
  */
diff --git a/src/mono/mono/sgen/sgen-client.h b/src/mono/mono/sgen/sgen-client.h
index 6ecfa09..5ffd275 100644
--- a/src/mono/mono/sgen/sgen-client.h
+++ b/src/mono/mono/sgen/sgen-client.h
@@ -192,6 +192,24 @@ void sgen_client_stop_world (int generation, gboolean serial_collection)
 void sgen_client_restart_world (int generation, gboolean serial_collection, gint64 *stw_time)
     MONO_PERMIT (need (sgen_gc_locked));
 
+/*
+ * Called at the end of a COLLECTION, with the mutators still suspended, immediately before the
+ * world is restarted.
+ *
+ * This is deliberately NOT `sgen_client_restart_world`, which is reached from every
+ * stop-the-world, collection or not.  `sgen_get_total_allocated_bytes (TRUE)` -- the
+ * implementation of the ordinary public `GC.GetTotalAllocatedBytes (precise: true)` -- and
+ * `sgen_check_whole_heap_stw ()` both stop the world, do their work and restart it WITHOUT
+ * collecting anything, and the arguments cannot tell the cases apart either, since both of those
+ * pass generation 0 exactly as a nursery collection does.
+ *
+ * So client work that depends on the collection having FINISHED -- a swept heap, unreachable
+ * objects no longer holding references, `sgen_client_clear_unreachable_ephemerons` having pruned
+ * the ephemeron list -- belongs here, and is silently wrong in the restart hook.
+ */
+void sgen_client_collection_end (int generation, gboolean serial_collection)
+    MONO_PERMIT (need (sgen_gc_locked, sgen_world_stopped));
+
 /*
  * Must return FALSE.  The bridge is not supported outside of Mono.
  */
diff --git a/src/mono/mono/sgen/sgen-gc.c b/src/mono/mono/sgen/sgen-gc.c
index 5457c34..8345b98 100644
--- a/src/mono/mono/sgen/sgen-gc.c
+++ b/src/mono/mono/sgen/sgen-gc.c
@@ -2709,8 +2709,18 @@ sgen_perform_collection_inner (size_t requested_size, int generation_to_collect,
 
 	time_max = MAX (time_max, time_last);
 
-	if (stw)
-		sgen_restart_world (oldest_generation_collected, forced_serial || !sgen_major_collector.is_concurrent);
+	if (stw) {
+		gboolean restart_serial = forced_serial || !sgen_major_collector.is_concurrent;
+
+		/*
+		 * The collection is finished and the mutators are still suspended: the one point at which a
+		 * client may look at a fully swept heap.  Kept separate from `sgen_client_restart_world`,
+		 * which is also reached from stop-the-worlds that never collect -- see the hook's comment in
+		 * sgen-client.h.
+		 */
+		sgen_client_collection_end (oldest_generation_collected, restart_serial);
+		sgen_restart_world (oldest_generation_collected, restart_serial);
+	}
 }
 
