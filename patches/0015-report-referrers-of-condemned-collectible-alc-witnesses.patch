+alc_condemned_set_collect (AlcCondemnedSetBuild *build)
+{
+	build->managers = g_hash_table_new (g_direct_hash, g_direct_equal);
+	build->witness_objects = g_hash_table_new (g_direct_hash, g_direct_equal);
+	build->managers_in_scope = 0;
+	build->live_witnesses = 0;
