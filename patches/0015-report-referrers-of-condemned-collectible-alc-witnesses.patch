+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static (int Armed, int AfterPreciseStw, int AfterCollection) RefuseThenStopTheWorldWithoutCollecting(
+            AssemblyLoadContext context)
+        {
+            object[] rooted = LoadUnloadReturningRootedPointerFreeProbe(context, losArray: true, new WeakReference[1]);
+
+            // Refuse once and let a REAL collection serve that first request, so the gauge is
+            // settled and the nursery is empty before the discriminating sequence below. Without
+            // this, an incidental nursery collection could serve the armed request between the
+            // arming force and the precise-bytes call, making the first assertion vacuous and the
+            // second one fail.
+            Assert.Equal(NotQuiescent, Force(context));
