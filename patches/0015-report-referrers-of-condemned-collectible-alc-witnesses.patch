+            // Undo the sustained refusal: see DriveTerminalAsync.
+            await DriveTerminalAsync(context);
+        }
+
+        // Own non-inlined frame, for the reason given on RefuseAndReadScanCount: the probe roots
+        // the witness across the refusal and both collections, and must be unreachable before the
+        // caller drives the context terminal.
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static (int Armed, int AfterNursery, int AfterFull, int MajorsBefore, int MajorsAfter)
+            RefuseThenCollectNurseryOnly(AssemblyLoadContext context)
+        {
+            object[] rooted = LoadUnloadReturningRootedPointerFreeProbe(context, losArray: true, new WeakReference[1]);
+
+            // Refuse once and let a REAL full collection serve that first request, for two reasons:
+            // the gauge is then settled, so an incidental collection cannot make the assertions
+            // vacuous; and the major allowance is freshly recomputed off a just-swept heap, which is
+            // what keeps the gen-0-only step below from escalating.
+            Assert.Equal(NotQuiescent, Force(context));
+            GcQuiesce();
+
+            // Both readings are taken BEFORE the arming force, so that the major-count bracket
+            // covers the force itself as well as the collection: kind 11 cannot move between here
+            // and the force, because nothing is armed yet for a collection to serve.
+            int armed = ScoutStats(11);
+            int majorsBefore = GC.CollectionCount(1);
+
+            // Arm. On a freshly quiesced nursery the few hundred bytes from here to the collection
