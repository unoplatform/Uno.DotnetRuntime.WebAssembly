+            // And the full collection must then serve it: GcQuiesce collects at GC.MaxGeneration.
+            GcQuiesce();
+            int afterFull = ScoutStats(11);
+
+            GC.KeepAlive(rooted);
+            return (armed, afterNursery, afterFull, majorsBefore, majorsAfter);
+        }
