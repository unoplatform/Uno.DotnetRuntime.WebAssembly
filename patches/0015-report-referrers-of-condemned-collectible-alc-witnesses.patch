+	/* No sgen: no heap walk exists. Say so, rather than letting silence read as "no referrers". */
+	mono_trace (G_LOG_LEVEL_INFO, MONO_TRACE_ASSEMBLY,
+		"[alc-referrers] unavailable: no sgen heap walk in this build");
+#endif
