+{
+	static int enabled = -1;
+	if (enabled == -1) {
+		char *val = g_getenv ("MONO_WASM_ALC_UNLOAD_REFERRER_SCAN");
+		enabled = (val && (!g_ascii_strcasecmp (val, "1") || !g_ascii_strcasecmp (val, "true"))) ? 1 : 0;
