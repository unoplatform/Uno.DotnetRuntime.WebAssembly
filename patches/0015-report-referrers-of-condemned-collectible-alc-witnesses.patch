+static gboolean
+alc_referrer_object_set_visit (MonoMemoryManager *mm, gpointer user_data)
+{
+	GHashTable *objects = (GHashTable *)user_data;
+
+	MonoObject *witness = alc_manager_witness_object (mm);
+	if (witness)
+		g_hash_table_insert (objects, witness, witness);
